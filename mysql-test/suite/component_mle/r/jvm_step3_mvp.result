#
# component_mle: fixes of the JVM worker from step 3 of the MVP code review
# (exp note 65): Java, the vector helper, JavaScript libraries.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE ON *.* TO root@localhost;
CREATE FUNCTION j_pid() RETURNS INT LANGUAGE JAVA AS $$ return 0; $$;
SELECT j_pid();
j_pid()
0
#
# JVMP-1: a result too large for a message is refused before it is
# encoded (150 M characters took the heap, and the worker, before): the
# routine's MLE-Type error; the worker goes on.
#
CREATE FUNCTION j_huge() RETURNS LONGTEXT LANGUAGE JAVA AS $$ return "\u00e9".repeat(150_000_000); $$;
SELECT j_huge();
ERROR HY000: MLE-Type> the routine's result is larger than MLE allows (64 MiB) in 'j_huge()'
SELECT j_pid();
j_pid()
0
include/assert.inc [The worker is not retired for it]
#
# JVMP-4: a Java routine that catches its InterruptedException and waits
# again is interrupted again: the time limit stops it, not the end of the
# worker.
#
CREATE FUNCTION j_sleepy() RETURNS INT LANGUAGE JAVA AS $$
try { Thread.sleep(60000); } catch (InterruptedException e) { }
try { Thread.sleep(60000); } catch (InterruptedException e) { }
try { Thread.sleep(60000); } catch (InterruptedException e) { throw new RuntimeException("interrupted again"); }
return 1;
$$;
SELECT /*+ MAX_EXECUTION_TIME(300) */ j_sleepy();
ERROR HY000: Query execution was interrupted, maximum statement execution time exceeded
SELECT j_pid();
j_pid()
0
include/assert.inc [The worker that ran it still serves]
#
# API-5: an id twice in one list counts once in rank fusion. API-2: a
# large k orders as a sort does; a batch beyond the bound is refused.
#
CREATE FUNCTION j_vectors() RETURNS TEXT LANGUAGE JAVA AS $$
StringBuilder b = new StringBuilder();
Matches a = Matches.of(new long[] {1, 1, 2}, new float[] {0.9f, 0.8f, 0.7f});
Matches c = Matches.of(new long[] {2}, new float[] {0.9f});
Matches f = Matches.fuse(a, c);
b.append("fuse:");
for (int i = 0; i < f.size(); i++) b.append(' ').append(f.id(i));
Random r = new Random(3);
float[][] rows = new float[2000][4];
for (float[] v : rows) for (int i = 0; i < 4; i++) v[i] = (float) r.nextGaussian();
float[] q = rows[0];
Matches m = Vectors.nearest(q, rows, 500, "dot");
Integer[] order = new Integer[rows.length];
float[] dots = new float[rows.length];
for (int j = 0; j < rows.length; j++) {
order[j] = j;
for (int i = 0; i < 4; i++) dots[j] += q[i] * rows[j][i];
}
java.util.Arrays.sort(order, (x, y) -> dots[x] != dots[y] ? Float.compare(dots[y], dots[x]) : Integer.compare(x, y));
int same = 0;
for (int i = 0; i < m.size(); i++) if (m.id(i) == order[i]) same++;
b.append(", k 500: ").append(m.size()).append(' ').append(same == m.size() ? "as sorted" : same + " as sorted");
try {
Vectors.related(new float[6000][2], 6000, "dot");
b.append(", related: done");
} catch (IllegalArgumentException e) {
b.append(", related: ").append(e.getMessage());
}
return b.toString();
$$;
SELECT j_vectors();
j_vectors()
fuse: 2 1, k 500: 500 as sorted, related: 6000 x 6000 best matches is more than 25000000: ask for fewer (k) or fewer queries at once
#
# JVML-8: an import of /schema/name finds the library when a directory of
# the schema's name exists (/tmp) but no such module file.
#
CREATE DATABASE tmp;
CREATE LIBRARY tmp.util LANGUAGE JAVASCRIPT AS $$ export const where = 'the library tmp.util' $$;
CREATE FUNCTION js_import_tmp() RETURNS TEXT LANGUAGE JAVASCRIPT AS $$
const m = await import('/tmp/util')
return m.where
$$;
SELECT js_import_tmp();
js_import_tmp()
the library tmp.util
DROP FUNCTION j_pid;
DROP FUNCTION j_huge;
DROP FUNCTION j_sleepy;
DROP FUNCTION j_vectors;
DROP FUNCTION js_import_tmp;
DROP DATABASE tmp;
REVOKE CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
