# AppArmor profile of Percona MLE's processes: mle_launcher, which mysqld
# starts, and the workers that run the routines. mysqld's own profile gets the
# few rules it needs from abstractions/percona-mle-mysqld.
#
# Workers are confined by Landlock and seccomp whatever AppArmor does; these
# profiles keep them out of mysqld's files (the data directory, the keyring,
# the configuration) at this layer too. A worker runs in the launcher's
# profile stacked with percona-mle-worker: the launcher sets no_new_privs
# before it starts a worker, and AppArmor then allows only a change to a
# stack that keeps the current profile (px -> percona-mle//&percona-mle-worker,
# label "percona-mle//&percona-mle-worker"), whose rules are both profiles' at
# once. So a worker can read but not write the cgroup files the launcher
# writes (memory.max of its own leaf; MVP review OPS-8). Paths added in
# local/percona-mle for workers (another mle.dir or mle.package_dir) go into
# local/percona-mle-worker too.
#
# The profile follows the mode of the server's profile as the package ships it
# (complain); `aa-enforce /etc/apparmor.d/percona-mle` enforces it. Other
# places for MLE's files (mle.dir, mle.java_home, mle.package_dir) go into
# /etc/apparmor.d/local/percona-mle.

abi <abi/3.0>,

include <tunables/global>

@{MLE_DIR}=/usr/lib/mysql/plugin/mle /usr/lib/mysql/plugin/debug/mle
@{MLE_PACKAGES}=/var/lib/mysql-mle-packages

profile percona-mle flags=(complain) {
  include <abstractions/base>

  # The launcher and the worker bootstrap.
  @{MLE_DIR}/mle_launcher mr,
  @{MLE_DIR}/mle_worker mr,
  @{MLE_DIR}/cpython/mle_cpython_worker mr,
  @{MLE_DIR}/v8/mle_v8_worker mr,
  @{MLE_DIR}/mle_worker px -> percona-mle//&percona-mle-worker,
  @{MLE_DIR}/cpython/mle_cpython_worker px -> percona-mle//&percona-mle-worker,
  @{MLE_DIR}/v8/mle_v8_worker px -> percona-mle//&percona-mle-worker,

  # MLE's files: the JDK, the jars, the AOT cache, Python and numpy.
  @{MLE_DIR}/ r,
  @{MLE_DIR}/** mr,

  # The CPython worker's standard library (the distribution's Python).
  /usr/lib{,64}/python3*/ r,
  /usr/lib{,64}/python3*/** mr,

  # Third-party packages the DBA installed with mle_package.
  @{MLE_PACKAGES}/ r,
  @{MLE_PACKAGES}/** mr,

  # The launcher builds each worker's Landlock rules: it lists the system
  # directories that lead to mysqld's plugin directory, which workers must
  # not read, to allow the entries around it one by one.
  /{usr/,}lib{,64}/ r,
  /usr/libexec/ r,
  /usr/lib/mysql/ r,
  /usr/lib/mysql/plugin/ r,

  # A worker is the first to go when memory runs out, and watches its own
  # memory.
  @{PROC}/@{pid}/oom_score_adj w,
  @{PROC}/@{pid}/statm r,

  # The workers' cgroups, below mysqld's delegated cgroup: the launcher makes
  # and limits them.
  @{PROC}/@{pid}/cgroup r,
  @{sys}/fs/cgroup/** rw,

  signal (send, receive) peer=percona-mle,
  signal (send, receive) peer=percona-mle-worker,
  signal (receive) peer=/usr/sbin/mysqld,
  unix (send, receive) type=seqpacket peer=(label=/usr/sbin/mysqld),
  unix (send, receive) type=seqpacket peer=(label=percona-mle-worker),

  # What the launcher and the workers report goes to mysqld's error log,
  # which they inherit. "w" and not "a": AppArmor checks mysqld's own later
  # writes to this shared open file against this profile too, as writes; with
  # less here mysqld's error log stops. An error log somewhere else goes
  # into local/percona-mle (without it only MLE's messages are lost).
  /var/log/mysql/** w,

  # Site-specific additions and overrides.
  include if exists <local/percona-mle>
}

# The workers: what they need of the launcher's rules, and the cgroup files
# only to read. Stacked on percona-mle (above), so a rule must be in both.
profile percona-mle-worker flags=(complain) {
  include <abstractions/base>

  @{MLE_DIR}/mle_worker mr,
  @{MLE_DIR}/cpython/mle_cpython_worker mr,
  @{MLE_DIR}/v8/mle_v8_worker mr,
  @{MLE_DIR}/ r,
  @{MLE_DIR}/** mr,
  /usr/lib{,64}/python3*/ r,
  /usr/lib{,64}/python3*/** mr,
  @{MLE_PACKAGES}/ r,
  @{MLE_PACKAGES}/** mr,

  @{PROC}/@{pid}/oom_score_adj w,
  @{PROC}/@{pid}/statm r,
  @{PROC}/@{pid}/cgroup r,
  @{sys}/fs/cgroup/** r,

  signal (send, receive) peer=percona-mle,
  signal (send, receive) peer=percona-mle-worker,
  signal (receive) peer=/usr/sbin/mysqld,
  unix (send, receive) type=seqpacket peer=(label=/usr/sbin/mysqld),
  unix (send, receive) type=seqpacket peer=(label=percona-mle),

  # The inherited error log: "w", as above.
  /var/log/mysql/** w,

  include if exists <local/percona-mle-worker>
}
