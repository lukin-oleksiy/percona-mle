#
# component_mle next to Percona's V8 component_js_lang behind
# component_lang_router: LANGUAGE JS runs in V8, LANGUAGE JAVASCRIPT,
# PYTHON and JAVA run in MLE.
#
INSTALL COMPONENT "file://component_js_lang";
INSTALL COMPONENT "file://component_mle";
INSTALL COMPONENT "file://component_lang_router";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
SELECT VARIABLE_VALUE AS backends FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Lang_router_backends';
backends
2
# In con1: js_lang refuses UNINSTALL while a session that used V8
# (also to compile at CREATE) is connected.
CREATE FUNCTION v8_f(a INT) RETURNS INT LANGUAGE JS AS $$ return a * 2 $$;
CREATE FUNCTION mle_js(a INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ return a * 2 $$;
CREATE FUNCTION mle_py(a INT) RETURNS INT LANGUAGE PYTHON AS $$ return a * 2 $$;
CREATE PROCEDURE mle_java(OUT r VARCHAR(20)) LANGUAGE JAVA AS $$ r[0] = "from Java"; $$;
# One statement: V8, then GraalJS, GraalPy and Java in the MLE worker.
SELECT v8_f(21) AS v8, mle_js(21) AS mle_js, mle_py(21) AS mle_py;
v8	mle_js	mle_py
42	42	42
CALL mle_java(@r);
SELECT @r;
@r
from Java
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME IN ('mle_stored_programs', 'Lang_router_live_handles')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
Lang_router_live_handles	4
mle_stored_programs	3
# MLE refuses UNINSTALL while con1 caches its routines; the router
# keeps routing both languages.
UNINSTALL COMPONENT "file://component_mle";
ERROR HY000: Language component: Cannot uninstall due to connected sessions. Please disconnect all sessions and try again.
SELECT v8_f(5) AS v8, mle_js(5) AS mle_js;
v8	mle_js
10	10
DROP FUNCTION v8_f;
DROP FUNCTION mle_js;
DROP FUNCTION mle_py;
DROP PROCEDURE mle_java;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_lang_router";
UNINSTALL COMPONENT "file://component_mle";
UNINSTALL COMPONENT "file://component_js_lang";
# js_lang cannot be installed again (V8) and leaves a read-only system
# variable registered until a restart (as in its own tests).
# restart
