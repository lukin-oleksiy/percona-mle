--echo #
--echo # component_mle: workers kept for later sessions of the same account
--echo # (mle.worker_cache_size, mle.worker_cache_timeout; 12 §17). A kept worker
--echo # was reset: no routines; its runtime stays warm.
--echo #
--source ../include/have_mle_component.inc
--source include/have_debug.inc
--source include/count_sessions.inc

INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
CREATE USER u1@localhost;
GRANT EXECUTE ON test.* TO u1@localhost;
SELECT @@mle.worker_cache_size, @@mle.worker_cache_timeout;
let $reuses0 = query_get_value(SHOW GLOBAL STATUS LIKE 'mle_worker_reuses', Value, 1);

--echo # A session uses a worker and ends: the worker is kept.
--connect (con1, localhost, root,,test)
CREATE FUNCTION js_add(a INT, b INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ return a + b $$;
CREATE FUNCTION js_inv(a INT) RETURNS INT SQL SECURITY INVOKER LANGUAGE JAVASCRIPT AS $$ return a $$;
CREATE FUNCTION py_leftover(v VARCHAR(10)) RETURNS VARCHAR(40) LANGUAGE PYTHON AS $$
    import builtins
    old = getattr(builtins, 'mle_leftover', None)
    builtins.mle_leftover = v
    return 'found ' + str(old)
$$;
SELECT js_add(1, 2), py_leftover('one');
let $pid1 = `SELECT mle_debug_worker_pid()`;
--disconnect con1
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # The next session of the same account gets it: the same process, its
--echo # routines prepared again. State in the languages' own modules stays
--echo # (same account, same privileges; documented).
--connect (con2, localhost, root,,test)
SELECT js_add(2, 3), py_leftover('two');
let $pid2 = `SELECT mle_debug_worker_pid()`;
let $same = `SELECT $pid1 = $pid2`;
--echo same worker process: $same
let $reuses = query_get_value(SHOW GLOBAL STATUS LIKE 'mle_worker_reuses', Value, 1);
let $more = `SELECT $reuses - $reuses0`;
--echo reuses: $more

--echo # Another account does not get it (an INVOKER routine runs as u1).
--connect (con3, localhost, u1,,test)
SELECT js_inv(7);
let $pid3 = `SELECT mle_debug_worker_pid()`;
let $other = `SELECT $pid3 <> $pid2`;
--echo another process for u1: $other
--disconnect con3
--disconnect con2
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # Back to back: once the ended session's worker no longer counts as held
--echo # (mle_workers), it is kept or still being reset, and the next session
--echo # waits for it rather than starting a new, cold one (exp note 34).
--connect (con6, localhost, root,,test)
SELECT js_add(6, 7);
let $pid6 = `SELECT mle_debug_worker_pid()`;
--disconnect con6
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers';
--source include/wait_condition.inc
--connect (con7, localhost, root,,test)
SELECT js_add(7, 8);
let $pid7 = `SELECT mle_debug_worker_pid()`;
let $same = `SELECT $pid6 = $pid7`;
--echo same worker process: $same
--disconnect con7
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # Java routines stay compiled in a kept worker (exp note 38): the next
--echo # session of the account reuses them, static state included; a changed
--echo # routine or USING library is compiled again.
--connect (con8, localhost, root,,test)
CREATE LIBRARY jlib LANGUAGE JAVA AS $$
package jlib;
public final class V { public static String v() { return "lib1"; } }
$$;
CREATE FUNCTION java_ver() RETURNS VARCHAR(20) LANGUAGE JAVA AS $$ return "v1"; $$;
CREATE FUNCTION java_lib() RETURNS VARCHAR(20) LANGUAGE JAVA USING (jlib) AS $$ return jlib.V.v(); $$;
CREATE FUNCTION java_count() RETURNS INT LANGUAGE JAVA AS $$ class C { static int n; } return ++C.n; $$;
SELECT java_ver(), java_lib(), java_count();
let $pid8 = `SELECT mle_debug_worker_pid()`;
--disconnect con8
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers';
--source include/wait_condition.inc
--connect (con9, localhost, root,,test)
SELECT java_ver(), java_lib(), java_count();
let $pid9 = `SELECT mle_debug_worker_pid()`;
let $same = `SELECT $pid8 = $pid9`;
--echo same worker process: $same
DROP FUNCTION java_ver;
CREATE FUNCTION java_ver() RETURNS VARCHAR(20) LANGUAGE JAVA AS $$ return "v2"; $$;
DROP FUNCTION java_lib;
DROP LIBRARY jlib;
CREATE LIBRARY jlib LANGUAGE JAVA AS $$
package jlib;
public final class V { public static String v() { return "lib2"; } }
$$;
CREATE FUNCTION java_lib() RETURNS VARCHAR(20) LANGUAGE JAVA USING (jlib) AS $$ return jlib.V.v(); $$;
SELECT java_ver(), java_lib();
--disconnect con9
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers';
--source include/wait_condition.inc
--connect (con10, localhost, root,,test)
SELECT java_ver(), java_lib(), java_count();
--disconnect con10
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # The same Java routine text in two schemas: two routines (their own
--echo # static state); a class that failed to initialise is compiled again by
--echo # the next session (it is not kept failed).
CREATE DATABASE wr1;
CREATE DATABASE wr2;
--connect (con11, localhost, root,,test)
CREATE FUNCTION wr1.cnt() RETURNS INT LANGUAGE JAVA AS $$ class C { static int n; } return ++C.n; $$;
CREATE FUNCTION wr2.cnt() RETURNS INT LANGUAGE JAVA AS $$ class C { static int n; } return ++C.n; $$;
SELECT wr1.cnt(), wr1.cnt(), wr2.cnt();
CREATE PROCEDURE wr1.init_once(OUT r BIGINT) LANGUAGE JAVA AS $$
  class C {
    static final long rows = ((Number) Mle.session().runSql("SELECT COUNT(*) FROM wr1.later").fetchOne().get(0)).longValue();
  }
  r[0] = C.rows;
$$;
--error ER_LANGUAGE_COMPONENT_RUNTIME
CALL wr1.init_once(@r);
--disconnect con11
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers';
--source include/wait_condition.inc
CREATE TABLE wr1.later (k INT);
INSERT INTO wr1.later VALUES (1), (2);
--connect (con12, localhost, root,,test)
CALL wr1.init_once(@r);
SELECT @r AS rows_seen;
--disconnect con12
--connection default
DROP DATABASE wr1;
DROP DATABASE wr2;
let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # Kept workers end after mle.worker_cache_timeout.
SET GLOBAL mle.worker_cache_timeout = 1;
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc
SET GLOBAL mle.worker_cache_timeout = DEFAULT;

--echo # mle.worker_cache_size = 0: a session's workers end with it.
SET GLOBAL mle.worker_cache_size = 0;
--connect (con4, localhost, root,,test)
SELECT js_add(4, 5);
--disconnect con4
--connection default
--source include/wait_until_count_sessions.inc
SELECT VARIABLE_VALUE AS kept FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
SET GLOBAL mle.worker_cache_size = DEFAULT;

--echo # UNINSTALL ends kept workers.
--connect (con5, localhost, root,,test)
SELECT js_add(5, 6);
--disconnect con5
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc
--source include/wait_until_count_sessions.inc
DROP FUNCTION js_add;
DROP FUNCTION js_inv;
DROP FUNCTION py_leftover;
DROP FUNCTION java_ver;
DROP FUNCTION java_lib;
DROP FUNCTION java_count;
DROP LIBRARY jlib;
DROP USER u1@localhost;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
