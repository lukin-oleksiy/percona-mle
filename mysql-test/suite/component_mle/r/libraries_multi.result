#
# component_mle (Phase 6): database libraries in Python and Java (our
# extension of Oracle's CREATE LIBRARY), and libraries used across
# languages (14-phase6-libraries.md §2).
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
CREATE LIBRARY jsmath LANGUAGE JAVASCRIPT AS $$
export function square(n) { return n * n }
export default { offset: 100 }
$$;
# Python libraries and routines (created by the mysql client: mysqltest
# strips the indentation Python needs).
# 1. Python routine with Python libraries (one imports the other).
CALL py_using(@r);
SELECT @r;
@r
5.0 | mean 5.00, stdev 2.00
# 2. Python routine with a JavaScript library.
SELECT py_uses_js(7);
py_uses_js(7)
149
# 3. JavaScript routine with a Python library.
CREATE FUNCTION js_uses_py() RETURNS TEXT LANGUAGE JAVASCRIPT USING (pystats AS stats)
AS $$ return 'mean ' + stats.mean([1, 2, 3, 6]) + ', stdev ' + stats.stdev([1, 2, 3, 6]).toFixed(3) $$;
SELECT js_uses_py();
js_uses_py()
mean 3, stdev 1.871
# 4. Java routine with a Java library (compiled with the routine).
CREATE LIBRARY geo LANGUAGE JAVA AS $$
package geo;
public final class Shapes {
private Shapes() {}
public static double diagonal(double w, double h) { return Math.sqrt(w * w + h * h); }
}
$$;
CREATE FUNCTION java_diag(w DOUBLE, h DOUBLE) RETURNS DOUBLE LANGUAGE JAVA USING (geo)
AS $$ return geo.Shapes.diagonal(w, h); $$;
SELECT java_diag(5, 10);
java_diag(5, 10)
11.180339887498949
# A Java routine compiles its Java libraries in; JavaScript and Python
# libraries (in USING, or of its own schema) come from Mle.importLibrary.
CREATE FUNCTION java_uses_js(n INT) RETURNS INT LANGUAGE JAVA USING (jsmath) AS $$
org.graalvm.polyglot.Value m = Mle.importLibrary("test.jsmath");
return m.invokeMember("square", n).asInt() + m.getMember("default").getMember("offset").asInt();
$$;
CREATE FUNCTION java_uses_py() RETURNS TEXT LANGUAGE JAVA AS $$
org.graalvm.polyglot.Value stats = Mle.importLibrary("/test/pystats");
return "mean " + stats.invokeMember("mean", java.util.List.of(1, 2, 3, 6)).asDouble();
$$;
SELECT java_uses_js(7), java_uses_py();
java_uses_js(7)	java_uses_py()
149	mean 3.0
# Another schema's library needs USING; a bad name is refused.
CREATE DATABASE other_lib;
CREATE LIBRARY other_lib.tiny LANGUAGE JAVASCRIPT AS $$ export const v = 42 $$;
CREATE FUNCTION java_other(using_it INT) RETURNS INT LANGUAGE JAVA AS $$
return Mle.importLibrary("other_lib.tiny").getMember("v").asInt();
$$;
SELECT java_other(0);
ERROR HY000: Java> java.lang.IllegalArgumentException: /other_lib/tiny: library other_lib.tiny is not importable from test.java_other (import it with USING, or use a library of the routine's schema) (java_other, line 2)
CREATE FUNCTION java_other_using() RETURNS INT LANGUAGE JAVA USING (other_lib.tiny) AS $$
return Mle.importLibrary("other_lib.tiny").getMember("v").asInt();
$$;
SELECT java_other_using();
java_other_using()
42
CREATE FUNCTION java_bad_name() RETURNS INT LANGUAGE JAVA AS $$
return Mle.importLibrary("nodot").getMember("v").asInt();
$$;
SELECT java_bad_name();
ERROR HY000: Java> java.lang.IllegalArgumentException: a library is 'schema.name' or '/schema/name', not 'nodot' (java_bad_name, line 2)
DROP FUNCTION java_uses_js;
DROP FUNCTION java_uses_py;
DROP FUNCTION java_other;
DROP FUNCTION java_other_using;
DROP FUNCTION java_bad_name;
DROP DATABASE other_lib;
# JavaScript uses a Java library too (its classes; see polyglot_reach).
CREATE FUNCTION js_uses_java() RETURNS DOUBLE LANGUAGE JAVASCRIPT USING (geo)
AS $$ return geo.Shapes.diagonal(3, 4) $$;
SELECT js_uses_java();
js_uses_java()
5
# 5. Syntax errors at CREATE LIBRARY, by language.
CREATE LIBRARY bad_py LANGUAGE PYTHON AS $$ def f(:
pass $$;
ERROR HY000: Python> IndentationError: unexpected indent (bad_py, line 1)
CREATE LIBRARY bad_java LANGUAGE JAVA AS $$ public class Bad { int x = ; } $$;
ERROR HY000: Java> bad_java:1:29: illegal start of expression
# 6. A changed library is used at the next call (here: JavaScript, from Python).
DROP LIBRARY jsmath;
CREATE LIBRARY jsmath LANGUAGE JAVASCRIPT AS $$
export function square(n) { return n * n * 10 }
export default { offset: 1 }
$$;
SELECT py_uses_js(7);
py_uses_js(7)
491
DROP PROCEDURE py_using;
DROP FUNCTION py_uses_js;
DROP FUNCTION js_uses_py;
DROP FUNCTION java_diag;
DROP FUNCTION js_uses_java;
DROP LIBRARY jsmath;
DROP LIBRARY pystats;
DROP LIBRARY pyreport;
DROP LIBRARY geo;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
