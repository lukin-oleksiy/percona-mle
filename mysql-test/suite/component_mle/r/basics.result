#
# component_mle (P4-W2): INSTALL starts the engine, system and status
# variables, LANGUAGE JAVASCRIPT / PYTHON / JAVA accepted at CREATE,
# UNINSTALL refused while sessions cache MLE routines.
#
INSTALL COMPONENT "file://component_mle";
# CREATE needs the language's privilege too (D-3; not in Oracle).
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
# The engine runs from INSTALL on (Oracle: Inactive until first use).
SELECT VARIABLE_VALUE AS mle_status FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_status';
mle_status
Active
# The pool fills: one JVM worker with Java, JavaScript and Python.
# System variables (paths differ per build).
SHOW GLOBAL VARIABLES LIKE 'mle.%';
Variable_name	Value
mle.cgroup_base	AUTO
mle.dir	/home/al/projects-m/BUILD-percona-server-my/plugin_output_directory/mle
mle.heap_max	536870912
mle.interrupt_grace_ms	1000
mle.java_home	/home/al/.sdkman/candidates/java/current
mle.languages	JAVASCRIPT,PYTHON,JAVA
mle.max_workers	64
mle.memory_max	2147483648
mle.package_dir	
mle.pool_prewarm	none
mle.pool_size	2
mle.spin_us	50
mle.sql_chunk_rows	1000
mle.sql_result_max	67108864
mle.sql_row_max	16777216
mle.sql_statements_max	1024
mle.worker_cache_size	4
mle.worker_cache_timeout	60
SELECT @@mle.dir = CONCAT(TRIM(TRAILING '/' FROM @@plugin_dir), '/mle') AS default_dir;
default_dir
1
# Status variables.
SHOW GLOBAL STATUS LIKE 'mle%';
Variable_name	Value
mle_cgroup	#
mle_heap_status	#
mle_languages_supported	#
mle_memory_used	#
mle_oom_errors	#
mle_pool_idle	#
mle_session_resets	#
mle_sessions	#
mle_sessions_max	#
mle_status	#
mle_stored_functions	#
mle_stored_procedures	#
mle_stored_program_bytes_max	#
mle_stored_program_sql_max	#
mle_stored_programs	#
mle_threads	#
mle_threads_max	#
mle_worker_failures	#
mle_worker_reuses	#
mle_workers	#
mle_workers_cached	#
mle_workers_spawned	#
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME IN ('mle_status', 'mle_heap_status',
'mle_languages_supported', 'mle_pool_idle', 'mle_workers',
'mle_stored_programs')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
mle_heap_status	Allocated
mle_languages_supported	JavaScript,Python,Java
mle_pool_idle	2
mle_status	Active
mle_stored_programs	0
mle_workers	0
#
# The three languages run in MLE (a session that used MLE blocks
# UNINSTALL until it disconnects, so the work is done in con1).
#
CREATE FUNCTION c_f() RETURNS INT LANGUAGE COBOL AS $$ $$;
ERROR HY000: Language component: Unsupported language 'COBOL'
CREATE FUNCTION js_f(a INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ return a + 1 $$;
CREATE PROCEDURE js_p() LANGUAGE javascript AS $$ console.log("hi") $$;
CREATE FUNCTION py_f(a INT) RETURNS INT LANGUAGE PYTHON AS $$ return a + 1 $$;
CREATE FUNCTION java_f(a INT) RETURNS INT LANGUAGE JAVA AS $$ return a + 1; $$;
SELECT ROUTINE_NAME, ROUTINE_TYPE, EXTERNAL_LANGUAGE FROM information_schema.routines
WHERE ROUTINE_SCHEMA = 'test' ORDER BY ROUTINE_NAME;
ROUTINE_NAME	ROUTINE_TYPE	EXTERNAL_LANGUAGE
java_f	FUNCTION	JAVA
js_f	FUNCTION	JAVASCRIPT
js_p	PROCEDURE	JAVASCRIPT
py_f	FUNCTION	PYTHON
SELECT js_f(1), py_f(2), java_f(3);
js_f(1)	py_f(2)	java_f(3)
2	3	4
CALL js_p();
# The session caches the routines: 3 functions, 1 procedure.
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME IN ('mle_stored_functions', 'mle_stored_procedures',
'mle_stored_programs', 'mle_sessions', 'mle_workers')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
mle_sessions	1
mle_stored_functions	3
mle_stored_procedures	1
mle_stored_programs	4
mle_workers	1
# UNINSTALL is refused while a session that used MLE is connected.
UNINSTALL COMPONENT "file://component_mle";
Got one of the listed errors
SELECT VARIABLE_VALUE AS mle_status FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_status';
mle_status
Active
SELECT VARIABLE_VALUE AS mle_stored_programs FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_stored_programs';
mle_stored_programs
0
#
# mle.languages
#
SET GLOBAL mle.languages = 'javascript, Java';
SELECT VARIABLE_VALUE AS mle_languages_supported FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_languages_supported';
mle_languages_supported
JavaScript,Java
CREATE FUNCTION py_g() RETURNS INT LANGUAGE PYTHON AS $$ return 1 $$;
ERROR HY000: Language component: Unsupported language 'PYTHON'
SET GLOBAL mle.languages = 'JAVASCRIPT,COBOL';
ERROR 42000: Variable 'mle.languages' can't be set to the value of 'JAVASCRIPT,COBOL'
SET GLOBAL mle.languages = 'JAVASCRIPT,';
ERROR 42000: Variable 'mle.languages' can't be set to the value of 'JAVASCRIPT,'
SET GLOBAL mle.languages = DEFAULT;
SELECT @@mle.languages;
@@mle.languages
JAVASCRIPT,PYTHON,JAVA
#
# Settings that shape workers restart the engine while no session
# holds a worker; out of range values are refused.
#
SET GLOBAL mle.heap_max = 256 * 1024 * 1024;
SET GLOBAL mle.memory_max = 1024 * 1024 * 1024, GLOBAL mle.pool_size = 2;
SELECT @@mle.heap_max, @@mle.memory_max, @@mle.pool_size;
@@mle.heap_max	@@mle.memory_max	@@mle.pool_size
268435456	1073741824	2
SELECT VARIABLE_VALUE AS mle_status FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_status';
mle_status
Active
SET GLOBAL mle.heap_max = 1024;
ERROR 42000: Variable 'mle.heap_max' can't be set to the value of '1024'
SET GLOBAL mle.memory_max = 1024;
ERROR 42000: Variable 'mle.memory_max' can't be set to the value of '1024'
SET GLOBAL mle.pool_size = 65;
ERROR 42000: Variable 'mle.pool_size' can't be set to the value of '65'
SET GLOBAL mle.pool_size = 'abc';
ERROR 42000: Incorrect argument type to variable 'mle.pool_size'
SET GLOBAL mle.heap_max = 1.5e9;
ERROR 42000: Incorrect argument type to variable 'mle.heap_max'
SET GLOBAL mle.max_workers = 8, GLOBAL mle.spin_us = 0,
GLOBAL mle.interrupt_grace_ms = 200;
SELECT @@mle.max_workers, @@mle.spin_us, @@mle.interrupt_grace_ms;
@@mle.max_workers	@@mle.spin_us	@@mle.interrupt_grace_ms
8	0	200
# What mysqld executes and where is read-only (like plugin_dir).
SET GLOBAL mle.dir = '/tmp';
ERROR HY000: Variable 'mle.dir' is a read only variable
SET GLOBAL mle.java_home = '/tmp';
ERROR HY000: Variable 'mle.java_home' is a read only variable
SET GLOBAL mle.cgroup_base = 'NONE';
ERROR HY000: Variable 'mle.cgroup_base' is a read only variable
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
#
# UNINSTALL stops the engine; INSTALL ... SET applies settings at once.
#
UNINSTALL COMPONENT "file://component_mle";
SELECT COUNT(*) AS mle_status_vars FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'mle%';
mle_status_vars
0
INSTALL COMPONENT "file://component_mle"
  SET GLOBAL mle.memory_max = 1536 * 1024 * 1024, GLOBAL mle.pool_size = 0;
SELECT @@mle.memory_max, @@mle.pool_size, @@mle.heap_max;
@@mle.memory_max	@@mle.pool_size	@@mle.heap_max
1610612736	0	536870912
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME IN ('mle_status', 'mle_heap_status', 'mle_pool_idle')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
mle_heap_status	Not Allocated
mle_pool_idle	0
mle_status	Active
# The error log tells how the engine runs.
include/assert_grep.inc [Both INSTALLs logged how the engine runs]
DROP FUNCTION js_f;
DROP PROCEDURE js_p;
DROP FUNCTION py_f;
DROP FUNCTION java_f;
UNINSTALL COMPONENT "file://component_mle";
