#
# 4. Prepared statements: binding rules and errors.
#
CREATE PROCEDURE prep(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
const try_ = (what, f) => { try { out.push(what + ': ' + f()) } catch (e) { out.push(what + ': ' + e.name
+ (e.code ? ' ' + e.code + ' ' + e.sqlState : '') + ': ' + e.message) } }
const p = session.prepare('SELECT ? + ? AS s')
try_('too few', () => p.bind(1).execute())
try_('accumulated', () => p.bind(2).execute().fetchOne().s)
try_('partial', () => p.bind(10).execute().fetchOne().s)
try_('too many', () => p.bind(1, 2, 3))
const old = p.execute()
p.execute()
try_('replaced', () => old.fetchOne())
p.deallocate()
try_('deallocated', () => p.bind(1))
try_('syntax', () => session.prepare('SELEC 1'))
r = out.join('\n')
$mle$|
CALL prep(@r);
SELECT @r;
@r
too few: SqlError 1210 HY000: Incorrect arguments to EXECUTE: 1 of 2 parameter markers bound
accumulated: 3
partial: 12
too many: SqlError 1210 HY000: Incorrect arguments to bind: 3 values for 2 parameter markers
replaced: Error: the result was replaced by a new execution of its prepared statement
deallocated: Error: the prepared statement was deallocated
syntax: SqlError 1064 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'SELEC 1' at line 1
#
# 5. Session variables as properties (Oracle's set_any_var).
#
CREATE PROCEDURE set_any_var(IN name VARCHAR(20), IN val INT) LANGUAGE JAVASCRIPT
AS $$ session[name] = val $$;
CALL set_any_var("yourvar", 100);
SELECT @yourvar;
@yourvar
100
SET @myvar = 27, @s = 'Something that is not 27', @dec = 1.5, @big = 9007199254740993;
CREATE PROCEDURE vars(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
for (const n of ['myvar', 's', 'dec', 'big', 'unset'])
out.push(n + ': ' + typeof session[n] + ' ' + session[n])
session.flag = true
session.when = new Date(Date.UTC(2024, 0, 2))
session.bin = new Uint8Array([65, 66])
session.obj = { a: 1 }
session['odd name`'] = 'quoted'
  try { session.sql = 1 } catch (e) { out.push(e.name + ': ' + e.message) }
r = out.join('\n')
$mle$|
SET time_zone = '+00:00';
CALL vars(@r);
SELECT @r;
@r
myvar: number 27
s: string Something that is not 27
dec: string 1.5
big: string 9007199254740993
unset: object null
TypeError: cannot set sql
SELECT @flag, @when, HEX(@bin), @obj, @`odd name```;
@flag	@when	HEX(@bin)	@obj	@`odd name```
1	2024-01-02 03:00:00.000000	4142	{"a":1}	quoted
SET time_zone = DEFAULT;
#
# 6. Schemas and tables.
#
CREATE PROCEDURE schema_api(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
const s = session.getDefaultSchema()
out.push(s.getName() + ' ' + s.existsInDatabase() + ' ' + (s.getSession() === session))
out.push(session.getSchemas().map((x) => x.getName()).filter((n) => ['test', 'mysql'].includes(n)).join(','))
out.push(s.getTables().map((t) => t.getName() + (t.isView() ? '(view)' : '')).join(','))
const t = s.getTable('t1')
out.push(t.getName() + ' ' + t.existsInDatabase() + ' ' + t.count() + ' ' + t.getSchema().getName())
const none = s.getTable('none')
out.push('none ' + none.existsInDatabase())
try { none.count() } catch (e) { out.push(e.code + ' ' + e.message) }
try { session.getSchema('nope') } catch (e) { out.push(e.code + ' ' + e.sqlState + ' ' + e.message) }
const n = session.createSchema('mle js`db')
out.push(n.getName() + ' ' + session.getSchema('mle js`db').existsInDatabase() + ' ' + session.quoteName('mle js`db'))
session.dropSchema('mle js`db')
out.push('dropped ' + n.existsInDatabase())
try { s.getFunction('nope') } catch (e) { out.push(e.code + ' ' + e.message) }
r = out.join('\n')
$mle$|
CALL schema_api(@r);
SELECT @r;
@r
test true true
mysql,test
t1,tp,v1(view)
t1 true 5 test
none false
1146 Table 'test.none' doesn't exist
1049 42000 Unknown database 'nope'
mle js`db true `mle js``db`
dropped false
1305 FUNCTION test.nope does not exist
#
# 7. Transactions: the caller's; savepoints; autocommit.
#
CREATE TABLE tx (k INT) ENGINE=InnoDB;
CREATE PROCEDURE tx(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
session.startTransaction()
session.runSql('INSERT INTO tx VALUES (1)')
const sp = session.setSavepoint()
session.runSql('INSERT INTO tx VALUES (2)')
const named = session.setSavepoint('mine')
session.runSql('INSERT INTO tx VALUES (3)')
session.rollbackTo(sp)
out.push(sp + ' ' + named + ' ' + session.runSql('SELECT GROUP_CONCAT(k) AS k FROM tx').fetchOne().k)
try { session.releaseSavepoint('') } catch (e) { out.push(e.name + ': ' + e.message) }
try { session.releaseSavepoint('mine') } catch (e) { out.push(e.code + ' ' + e.message) }
session.commit()
session.runSql('INSERT INTO tx VALUES (4)')
session.rollback()
const before = session.autocommit()
session.autocommit(false)
const off = session.autocommit()
session.autocommit(true)
out.push('autocommit ' + before + ' ' + off + ' ' + session.autocommit())
r = out.join('\n')
$mle$|
CALL tx(@r);
SELECT @r;
@r
TxSp1 mine 1
TypeError: the savepoint name must not be empty
1305 SAVEPOINT mine does not exist
autocommit 1 0 1
SELECT * FROM tx;
k
1
4
#
# 8. mysql.*: rand, uuid (version 1), isUUID, sleep; they also work in
#    functions, where SQL is not allowed (6120).
#
CREATE FUNCTION fns() RETURNS TEXT LANGUAGE JAVASCRIPT AS $mle$
const out = []
const x = mysql.rand()
out.push(typeof x + ' ' + (x >= 0 && x < 1))
const u = mysql.uuid(), v = mysql.uuid()
out.push(/^[0-9a-f]{8}-[0-9a-f]{4}-1[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(u) + ' ' + (u !== v))
out.push([u, u.replaceAll('-', ''), '{' + u + '}', 'nope', null].map((y) => mysql.isUUID(y)).join(','))
out.push(mysql.sleep(0.01) + ' ' + Object.keys(mysql.IntegerType).join(',') + ' ' + mysql.Type.VECTOR)
try { session.runSql('SELECT 1') } catch (e) { out.push(e.code + ' ' + (e instanceof SqlError)) }
return out.join('\n')
$mle$|
SELECT fns();
fns()
number true
true true
1,1,1,0,
0 BIGINT,STRING,UNSAFE_BIGINT,UNSAFE_STRING VECTOR
6120 true
SELECT IS_UUID(fns()) IS NOT NULL;
IS_UUID(fns()) IS NOT NULL
1
#
# 9. Errors: SqlError objects of statements; thrown SqlErrors; a thrown
#    SqlError without an error number is SIGNAL's default (1644).
#
CREATE PROCEDURE errs(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
try { session.runSql('SELECT * FROM bogus') }
catch (e) { out.push([e instanceof SqlError, e instanceof Error, e.name, e.code, e.sqlState, e.message].join(' | ')) }
out.push(String(new SqlError('HY000', 'text', 1234)))
try { new SqlError(NaN, 'x', 1) } catch (e) { out.push(e.name + ': ' + e.message) }
r = out.join('\n')
$mle$|
CALL errs(@r);
SELECT @r;
@r
true | true | SqlError | 1146 | 42S02 | Table 'test.bogus' doesn't exist
SqlError: Error code: 1234 Error state: HY000 Error message: text
TypeError: SqlError: sql_state must be a finite number
CREATE PROCEDURE throw_default() LANGUAGE JAVASCRIPT AS $$ throw new SqlError(45000, 'mine') $$;
CALL throw_default();
ERROR 45000: mine
CREATE PROCEDURE throw_state() LANGUAGE JAVASCRIPT AS $$ throw new SqlError('HY000', 'with state', 1234) $$;
CALL throw_state();
ERROR HY000: with state
# A caught error leaves no trace; the call ends normally.
CREATE PROCEDURE caught() LANGUAGE JAVASCRIPT
AS $$ try { session.runSql('SELECT * FROM bogus') } catch (e) {} $$;
CALL caught();
SHOW WARNINGS;
Level	Code	Message
#
# 10. KILL QUERY during mysql.sleep.
#
CREATE PROCEDURE sleeper() LANGUAGE JAVASCRIPT AS $$ mysql.sleep(60); while (true) {} $$;
CALL sleeper();
ERROR 70100: Query execution was interrupted
