#
# component_mle: regressions for the minor findings of the independent
# multi-model review (exp notes 60 and 61).
#
call mtr.add_suppression("Component mle reported: 'The worker of .* was retired");
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JS_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
CREATE TABLE t (id INT PRIMARY KEY, v VARCHAR(20));
CREATE TABLE parent (id INT PRIMARY KEY);
CREATE TABLE child (id INT PRIMARY KEY, a_rather_long_column_name_for_the_parent_reference INT,
CONSTRAINT a_foreign_key_constraint_with_quite_a_long_name_for_a_message
FOREIGN KEY (a_rather_long_column_name_for_the_parent_reference) REFERENCES parent (id));
CREATE TABLE kinds (d DATE, tm TIME, dt DATETIME, ts TIMESTAMP NULL, de DECIMAL(10,2), tx TEXT, vb VARBINARY(10),
b BINARY(4), bl BLOB, c CHAR(3));
# C126: twice with the same worker.
SET @pid = mle_debug_worker_pid();
SELECT py_resize(TO_VECTOR('[1,2,3,4]')) AS first;
first
owns False ValueError 4
SELECT py_resize(TO_VECTOR('[5,6,7,8]')) AS second;
second
owns False ValueError 4
# C129
SELECT js_liar();
js_liar()
true
# C60, C162
SELECT js_context();
js_context()
context refused, ProcessHandle refused
CALL java_close();
# A Java routine may close it: the next script call finds it closed, and
# the worker is replaced (it used to stay, failing every call). It is an
# error of guest code, not an interrupt: none was requested (protocol 10.6).
SELECT js_one();
ERROR HY000: JavaScript> the worker's context was closed by a routine
SELECT js_one() AS works_after;
works_after
1
SET @pid = mle_debug_worker_pid();
