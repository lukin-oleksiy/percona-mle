#!/bin/sh
set -e

# AppArmor: take MLE's rules out of mysqld's profile and MLE's profile out of
# the kernel (see postinst). The files in /etc/apparmor.d are configuration
# files: they stay until the package is purged.
LOCAL=/etc/apparmor.d/local/usr.sbin.mysqld

case "$1" in
	remove|purge)
		if [ -f $LOCAL ]; then
			sed -i '/<abstractions\/percona-mle-mysqld>/d' $LOCAL
		fi
		if command -v aa-enabled >/dev/null 2>&1 && aa-enabled --quiet 2>/dev/null; then
			if [ -f /etc/apparmor.d/usr.sbin.mysqld ]; then
				apparmor_parser -r -T -W /etc/apparmor.d/usr.sbin.mysqld || true
			fi
			# Both profiles of the file: the launcher's and the workers' (stacked on it).
			for profile in percona-mle percona-mle-worker; do
				if [ -d /sys/kernel/security/apparmor/policy/profiles ] &&
					ls /sys/kernel/security/apparmor/policy/profiles | grep -q "^$profile\."; then
					echo -n $profile > /sys/kernel/security/apparmor/.remove 2>/dev/null || true
				fi
			done
		fi
		;;
esac
if [ "$1" = purge ]; then
	rm -f /etc/apparmor.d/local/percona-mle /etc/apparmor.d/local/percona-mle-worker
fi

# (no debhelper: packages built with CPack, cmake/packaging.cmake)
exit 0
