#
# component_mle (P5-W3): the JavaScript SQL API beyond Oracle's examples:
# values and options, parameters, rows, results, session variables,
# schemas and tables, transactions, mysql.*, errors.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE ON *.* TO root@localhost;
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, v VARCHAR(20), n INT);
INSERT INTO t1 (v, n) VALUES ('one', 1), ('two', 2), ('three', 3);
CREATE VIEW v1 AS SELECT v FROM t1;
SET SESSION cte_max_recursion_depth = 100000;
#
# 1. Values of all types, with their JavaScript types (defaults:
#    integers as numbers when safe, else strings; DECIMAL as strings).
#
CREATE PROCEDURE types(IN opts JSON) LANGUAGE JAVASCRIPT AS $mle$
console.clear()
const show = (v) => v === null ? 'null'
      : v instanceof Date ? 'Date ' + v.toISOString()
: v instanceof Uint8Array ? 'Uint8Array ' + Array.from(v).join(' ')
: v instanceof Float32Array ? 'Float32Array ' + Array.from(v).join(' ')
: typeof v === 'object' ? 'object ' + JSON.stringify(v)
: typeof v + ' ' + String(v)
const r = session.sql(`SELECT -5 AS i, 9007199254740993 AS big,
      CAST(18446744073709551615 AS UNSIGNED) AS ubig, 2.5e0 AS d, CAST(1.25 AS FLOAT) AS f,
      CAST(1.25 AS DECIMAL(6,3)) AS decm, 'héllo' AS s, x'00ff' AS b, CAST('{"a": [1, 2]}' AS JSON) AS j,
      DATE'2024-01-02' AS dt, TIME'12:34:56.5' AS tm, TIMESTAMP'2024-01-02 03:04:05.678' AS ts,
      STRING_TO_VECTOR('[1,2.5]') AS vec, b'101' AS bits, CAST(2024 AS YEAR) AS yr, NULL AS nul`,
opts).execute()
const row = r.fetchOne()
for (const c of r.getColumns())
console.log(c.getColumnLabel() + ': ' + c.getType() + ': ' + show(row[c.getColumnLabel()]))
$mle$|
CALL types(NULL);
SELECT mle_session_state('stdout');
mle_session_state('stdout')
i: BIGINT: number -5
big: BIGINT: string 9007199254740993
ubig: BIGINT: string 18446744073709551615
d: DOUBLE: number 2.5
f: FLOAT: number 1.25
decm: DECIMAL: string 1.250
s: STRING: string héllo
b: BYTES: Uint8Array 0 255
j: JSON: object {"a":[1,2]}
dt: DATE: Date 2024-01-01T21:00:00.000Z
tm: TIME: string 12:34:56.500000
ts: DATETIME: Date 2024-01-02T00:04:05.678Z
vec: VECTOR: Float32Array 1 2.5
bits: BYTES: Uint8Array 5
yr: INT: number 2024
nul: BYTES: null

# integerType BIGINT and decimalType NUMBER for one statement.
CALL types('{"integerType": "BIGINT", "decimalType": "NUMBER"}');
SELECT mle_session_state('stdout');
mle_session_state('stdout')
i: BIGINT: bigint -5
big: BIGINT: bigint 9007199254740993
ubig: BIGINT: bigint 18446744073709551615
d: DOUBLE: number 2.5
f: FLOAT: number 1.25
decm: DECIMAL: number 1.25
s: STRING: string héllo
b: BYTES: Uint8Array 0 255
j: JSON: object {"a":[1,2]}
dt: DATE: Date 2024-01-01T21:00:00.000Z
tm: TIME: string 12:34:56.500000
ts: DATETIME: Date 2024-01-02T00:04:05.678Z
vec: VECTOR: Float32Array 1 2.5
bits: BYTES: Uint8Array 5
yr: INT: number 2024
nul: BYTES: null

# integerType STRING; and UNSAFE_BIGINT (only unsafe values are BigInts).
CREATE PROCEDURE int_types(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const q = 'SELECT 5 AS a, 9007199254740993 AS b'
  const out = []
for (const t of [mysql.IntegerType.STRING, mysql.IntegerType.UNSAFE_BIGINT, mysql.IntegerType.UNSAFE_STRING]) {
const row = session.sql(q, { integerType: t }).execute().fetchOne()
out.push(t + ': ' + typeof row.a + ' ' + typeof row.b + ' ' + row.b)
}
// Session defaults for the rest of the call; options of a statement win.
session.setOptions({ integerType: 'BIGINT', decimalType: mysql.DecimalType.NUMBER })
out.push('setOptions: ' + typeof session.sql(q).execute().fetchOne().a + ' '
      + session.getOption('integerType') + ' ' + session.getOption('decimalType') + ' '
      + session.getOption('passResultToClient') + ' ' + session.getOption('charsetName'))
const x = session.sql(q, { integerType: 'STRING' })
out.push('statement: ' + typeof x.execute().fetchOne().a + ' ' + x.getOption('integerType'))
r = out.join('\n')
$mle$|
CALL int_types(@r);
SELECT @r;
@r
STRING: string string 9007199254740993
UNSAFE_BIGINT: number bigint 9007199254740993
UNSAFE_STRING: number string 9007199254740993
setOptions: bigint BIGINT NUMBER false utf8mb4
statement: string STRING
# setOptions holds only for the call that set it.
CREATE PROCEDURE int_default(OUT r TEXT) LANGUAGE JAVASCRIPT
AS $$ r = typeof session.sql('SELECT 5 AS a').execute().fetchOne().a $$;
CALL int_default(@r);
SELECT @r;
@r
number
# The session state's integer_type is the default (Oracle's; set
# after a reset).
SELECT mle_session_reset();
mle_session_reset()
The session state is successfully reset.
SELECT mle_set_session_state('{"integer_type": "STRING"}');
mle_set_session_state('{"integer_type": "STRING"}')
1
CALL int_default(@r);
SELECT @r;
@r
string
SELECT mle_session_reset();
mle_session_reset()
The session state is successfully reset.
#
# 2. Parameters: runSql with values of all kinds; round trips.
#
CREATE TABLE tp (i BIGINT, d DOUBLE, s VARCHAR(20), b BLOB, j JSON, dt DATETIME(3),
vec VECTOR(2), st SET('a', 'b', 'c'), u BIGINT UNSIGNED, bo TINYINT);
CREATE PROCEDURE params(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
session.runSql('INSERT INTO tp VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
[42, 2.5, 'text', new Uint8Array([0, 255, 7]), { k: [1, 'x'] },
new Date(Date.UTC(2024, 0, 2, 3, 4, 5, 678)), new Float32Array([1, 2.5]),
new Set(['a', 'c']), 18446744073709551615n, true])
session.runSql('INSERT INTO tp (i, s) VALUES (?, ?)', [null, undefined])
const res = session.runSql('SELECT i, d, s, HEX(b) AS b, j, dt, VECTOR_TO_STRING(vec) AS vec, st, u, bo ' +
'FROM tp ORDER BY i IS NULL, i', [], { integerType: 'STRING' })
r = res.fetchAll().map((row) => row.toArray().map((v) =>
v instanceof Date ? v.toISOString() : typeof v === 'object' && v !== null ? JSON.stringify(v) : String(v))
.join(' | ')).join('\n')
$mle$|
SET time_zone = '+00:00';
CALL params(@r);
SELECT @r;
@r
42 | 2.5 | text | 00FF07 | {"k":[1,"x"]} | 2024-01-02T03:04:05.678Z | [1.00000e+00,2.50000e+00] | a,c | 18446744073709551615 | 1
null | null | null | null | null | null | null | null | null | null
SELECT i, d, s, HEX(b), j, dt, VECTOR_TO_STRING(vec), st, u, bo FROM tp;
i	d	s	HEX(b)	j	dt	VECTOR_TO_STRING(vec)	st	u	bo
42	2.5	text	00FF07	{"k": [1, "x"]}	2024-01-02 06:04:05.678	[1.00000e+00,2.50000e+00]	a,c	18446744073709551615	1
NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
SET time_zone = DEFAULT;
# Values that cannot be bound: TypeErrors.
CREATE PROCEDURE bad_params(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
for (const v of [NaN, Infinity, Symbol('s'), () => 1, new Date(NaN), mysql.arg(1)]) {
try { session.runSql('SELECT ?', [v]); out.push('bound') }
catch (e) { out.push(e.name + ': ' + e.message) }
}
r = out.join('\n')
$mle$|
CALL bad_params(@r);
SELECT @r;
@r
TypeError: cannot bind NaN
TypeError: cannot bind Infinity
TypeError: cannot bind a symbol
TypeError: cannot bind a function
TypeError: cannot bind an invalid Date
TypeError: mysql.arg() values are for OUT and INOUT parameters of procedures
#
# 3. Rows and results: access forms, fetchAll, OKs, warnings, execution
#    time, several result sets, passResultToClient, many rows.
#
CREATE PROCEDURE rows_api(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
const res = session.runSql('SELECT id, v AS name, n, n AS n FROM t1 ORDER BY id')
const row = res.fetchOne()
out.push([row.id, row['name'], row[2], row.getField('n'), row.getLength(), row.toArray().length,
Object.keys(row).join('|'), JSON.stringify(row), row.nope, row[9]].join(' '))
out.push('rest: ' + res.fetchAll().map((x) => x.name).join(',') + ' then ' + res.fetchOne())
out.push('hasData ' + res.hasData() + ', next ' + res.nextResult() + ', count ' + res.getColumnCount())
const ins = session.runSql("INSERT INTO t1 (v, n) VALUES ('four', 4), ('five', 5)")
out.push('insert: hasData ' + ins.hasData() + ', affected ' + ins.getAffectedItemsCount() + ', id '
      + ins.getAutoIncrementValue() + ', columns ' + ins.getColumnCount() + ', row ' + ins.fetchOne())
const w = session.runSql("SELECT CAST('12abc' AS SIGNED) AS x")
out.push('warnings ' + w.getWarningsCount() + ': ' + w.getWarnings().map((x) =>
x.level + ' ' + x.code + ' ' + x.message).join('; '))
out.push('time: ' + /^\d+\.\d{4} sec$/.test(w.getExecutionTime()))
try { row.getField('nope') } catch (e) { out.push(e.name + ': ' + e.message) }
r = out.join('\n')
$mle$|
CREATE PROCEDURE two_sets() BEGIN SELECT 1 AS a; SELECT 'x' AS b, 'y' AS c; END|
CREATE PROCEDURE sets(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const out = []
const res = session.runSql('CALL two_sets()')
do {
out.push(res.hasData() ? res.getColumnNames() + ': ' + res.fetchAll().map((x) => x.toArray()).join(';')
: 'OK ' + res.getAffectedItemsCount())
} while (res.nextResult() ? true : res.hasData())
// Rows left unread are skipped by nextResult.
const res2 = session.runSql('CALL two_sets()')
out.push('skip: ' + res2.nextResult() + ' ' + res2.fetchOne().c)
res2.close()
r = out.join('\n')
$mle$|
CREATE PROCEDURE to_client() LANGUAGE JAVASCRIPT AS $mle$
const r1 = session.sql('SELECT v, n FROM t1 WHERE n < 3 ORDER BY n', { passResultToClient: true }).execute()
const p = session.prepare('SELECT ? AS prepared', { passResultToClient: true })
const r2 = p.bind('to the client').execute()
const r3 = session.runSql('CALL two_sets()', [], { passResultToClient: true })
console.clear()
console.log(String(r1) + ' ' + String(r2) + ' ' + String(r3) + ' ' + p.getOption('passResultToClient'))
$mle$|
CREATE PROCEDURE many(OUT r TEXT) LANGUAGE JAVASCRIPT AS $mle$
const q = 'WITH RECURSIVE c(k) AS (SELECT 1 UNION ALL SELECT k + 1 FROM c WHERE k < ?) SELECT k FROM c'
  let n = 0, sum = 0
const res = session.runSql(q, [5000])
for (let row = res.fetchOne(); row; row = res.fetchOne()) { n++; sum += row.k }
const all = session.sql(q.replace('?', '5000')).execute().fetchAll()
r = n + ' ' + sum + ' ' + all.length + ' ' + all[4999].k
$mle$|
CALL rows_api(@r);
Warnings:
Warning	1292	Truncated incorrect INTEGER value: '12abc'
SELECT @r;
@r
