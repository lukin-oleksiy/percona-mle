other.items vectors rows 2 uses 0 kept
test.items vectors rows 9 uses 5 kept
# 4. COM_RESET_CONNECTION keeps it; mle_session_reset() and COM_CHANGE_USER empty it.
CALL info(@r);
SELECT @r AS after_reset_connection;
