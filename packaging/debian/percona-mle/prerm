#!/bin/sh
set -e

# The AOT cache is not a file of the package: remove it with the package (an
# upgrade makes a new one).
case "$1" in
	remove|upgrade|deconfigure)
		rm -f /usr/lib/mysql/plugin/mle/mle.aot /usr/lib/mysql/plugin/mle/mle.aot.new
		;;
esac

# (no debhelper: packages built with CPack, cmake/packaging.cmake)
exit 0
