#
# component_mle (P4-W5): KILL, max_execution_time, workers and the
# launcher lost, heap exhaustion, privileges. The server survives all of
# them and the session works on.
#
call mtr.add_suppression("Component mle reported: 'The worker of .* was (lost|retired)");
INSTALL COMPONENT "file://component_mle";
# A small heap, so that exhausting it is quick; a short KILL grace.
SET GLOBAL mle.heap_max = 128 * 1024 * 1024, GLOBAL mle.interrupt_grace_ms = 300;
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
CREATE FUNCTION js_loop() RETURNS INT LANGUAGE JAVASCRIPT AS $$ for (;;) {} $$;
CREATE FUNCTION java_loop() RETURNS INT LANGUAGE JAVA
AS $$ long x = 0; while (x >= 0) { x = (x + 1) % 1000; } return 0; $$;
CREATE FUNCTION js_ok() RETURNS INT LANGUAGE JAVASCRIPT AS $$ return 7 $$;
CREATE FUNCTION js_hog() RETURNS INT LANGUAGE JAVASCRIPT AS $$
const keep = [];
for (;;) keep.push(new Array(1000000).fill(1.5));
$$;
SELECT js_ok();
js_ok()
7
#
# 1. KILL QUERY of a JavaScript loop: the worker stops the call and stays.
#
SELECT js_loop();
KILL QUERY CON1;
ERROR 70100: Query execution was interrupted
SELECT js_ok();
js_ok()
7
include/assert.inc [The same worker after KILL QUERY]
#
# 2. max_execution_time.
#
SELECT /*+ MAX_EXECUTION_TIME(500) */ js_loop();
ERROR HY000: Query execution was interrupted, maximum statement execution time exceeded
SELECT js_ok();
js_ok()
7
#
# 3. KILL QUERY of a Java loop that does not stop: the worker is killed
#    after mle.interrupt_grace_ms; the next call gets a fresh one.
#
SELECT java_loop();
KILL QUERY CON1;
ERROR 70100: Query execution was interrupted
SELECT js_ok();
js_ok()
7
include/assert.inc [A new worker after the old one was killed]
#
# 4. The worker killed from outside: the call fails (6111), the next one
#    runs in a fresh worker.
#
SELECT js_ok();
ERROR HY000: Language component: Internal error.
SELECT js_ok();
js_ok()
7
#
# 5. Heap exhausted: a guest error; the worker is retired.
#
SELECT js_hog();
ERROR HY000: JavaScript> <out of memory>
SELECT js_ok();
js_ok()
7
include/assert.inc [A new worker after heap exhaustion]
#
# 6. The launcher killed: its workers die with it; the engine starts a
#    new launcher when the next worker is needed.
#
SELECT js_ok();
ERROR HY000: Language component: Internal error.
SELECT js_ok();
js_ok()
7
SELECT VARIABLE_VALUE AS mle_status FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_status';
mle_status
Active
# Lost: the killed Java loop, kill -9, the launcher (OOM counts apart).
SELECT VARIABLE_VALUE >= 3 AS failures_counted FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_worker_failures';
failures_counted
1
SELECT VARIABLE_VALUE >= 1 AS oom_counted FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_oom_errors';
oom_counted
1
#
# 7. CREATE needs CREATE_<LANGUAGE>_ROUTINE (D-3); calling does not.
#
CREATE USER u2@localhost;
GRANT CREATE ROUTINE, EXECUTE ON test.* TO u2@localhost;
GRANT CREATE_PYTHON_ROUTINE ON *.* TO u2@localhost;
CREATE FUNCTION u2_js() RETURNS INT LANGUAGE JAVASCRIPT AS $$ return 1 $$;
ERROR 42000: Access denied; you need (at least one of) the CREATE_JAVASCRIPT_ROUTINE privilege(s) for this operation
CREATE FUNCTION u2_java() RETURNS INT LANGUAGE JAVA AS $$ return 1; $$;
ERROR 42000: Access denied; you need (at least one of) the CREATE_JAVA_ROUTINE privilege(s) for this operation
CREATE FUNCTION u2_py() RETURNS INT LANGUAGE PYTHON AS $$ return 3 $$;
SELECT u2_py(), js_ok();
u2_py()	js_ok()
3	7
# The server is fine.
SELECT 1 AS alive;
alive
1
DROP FUNCTION js_loop;
DROP FUNCTION java_loop;
DROP FUNCTION js_ok;
DROP FUNCTION js_hog;
DROP FUNCTION u2_py;
DROP USER u2@localhost;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
