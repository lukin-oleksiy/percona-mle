CALL other.near(@r);
SELECT @r AS other_schema;
other_schema
2 rows in schema other: ids [100, 101]
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
SELECT @r AS this_schema;
this_schema
