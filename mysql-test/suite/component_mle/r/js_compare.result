#
# js_lang (Percona, V8 in mysqld: LANGUAGE JS) and component_mle
# (GraalJS in a worker process: LANGUAGE JAVASCRIPT, Oracle's form) side
# by side: the same bodies, what each engine gives. A comparison, not a
# conformance test: differences are expected and shown.
# Not compared here (they would stop a debug server): VECTOR arguments in
# js_lang (no VECTOR conversion: assert(false)), and V8 called from SQL
# inside an MLE routine (js_lang asserts when another component holds the
# session's KILL handler).
#
INSTALL COMPONENT "file://component_js_lang";
INSTALL COMPONENT "file://component_mle";
INSTALL COMPONENT "file://component_lang_router";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_JS_ROUTINE ON *.* TO root@localhost;
#
# 1. Arguments: what JavaScript sees for each SQL type.
#
CREATE FUNCTION v8_args(i BIGINT, u BIGINT UNSIGNED, d DECIMAL(10,3), f DOUBLE, s VARCHAR(10), b VARBINARY(4), j JSON, dt DATE, ts DATETIME(3), tm TIME, st SET('a','b','c'), bt BIT(8), y YEAR) RETURNS TEXT LANGUAGE JS AS $$ const show = (v) => v === null ? 'null' : (v instanceof Date ? 'Date ' + v.toISOString() : v instanceof DataView ? 'DataView ' + v.byteLength : v instanceof Set ? 'Set ' + [...v].join(',') : ArrayBuffer.isView(v) ? v.constructor.name + ' ' + Array.from(v).join(',') : typeof v === 'object' ? 'object ' + JSON.stringify(v) : typeof v + ' ' + String(v)); return [i, u, d, f, s, b, j, dt, ts, tm, st, bt, y].map(show).join(' | ') $$;
CREATE FUNCTION mle_args(i BIGINT, u BIGINT UNSIGNED, d DECIMAL(10,3), f DOUBLE, s VARCHAR(10), b VARBINARY(4), j JSON, dt DATE, ts DATETIME(3), tm TIME, st SET('a','b','c'), bt BIT(8), y YEAR) RETURNS TEXT LANGUAGE JAVASCRIPT AS $$ const show = (v) => v === null ? 'null' : (v instanceof Date ? 'Date ' + v.toISOString() : v instanceof DataView ? 'DataView ' + v.byteLength : v instanceof Set ? 'Set ' + [...v].join(',') : ArrayBuffer.isView(v) ? v.constructor.name + ' ' + Array.from(v).join(',') : typeof v === 'object' ? 'object ' + JSON.stringify(v) : typeof v + ' ' + String(v)); return [i, u, d, f, s, b, j, dt, ts, tm, st, bt, y].map(show).join(' | ') $$;
SET time_zone = '+00:00';
SELECT REPLACE(v8_args(9007199254740993, 18446744073709551615, 1.25, 2.5, 'héllo', x'00ff', '{"a": [1, 2]}', '2024-01-02', '2024-01-02 03:04:05.678', '12:34:56', 'a,c', b'101', 2024), ' | ', '\n') AS js_lang;
js_lang
bigint 9007199254740993
bigint 18446744073709551615
string 1.250
number 2.5
string héllo
DataView 2
object {"a":[1,2]}
string 2024-01-02
string 2024-01-02 03:04:05.678
string 12:34:56
string a,c
number 5
number 2024
SELECT REPLACE(mle_args(9007199254740993, 18446744073709551615, 1.25, 2.5, 'héllo', x'00ff', '{"a": [1, 2]}', '2024-01-02', '2024-01-02 03:04:05.678', '12:34:56', 'a,c', b'101', 2024), ' | ', '\n') AS mle;
mle
string 9007199254740993
string 18446744073709551615
string 1.250
number 2.5
string héllo
Uint8Array 0,255
object {"a":[1,2]}
Date 2024-01-01T21:00:00.000Z
Date 2024-01-02T00:04:05.678Z
string 12:34:56
Set a,c
number 5
number 2024
SET time_zone = DEFAULT;
#
# 2. Results: the same JavaScript values returned as SQL types.
#
CREATE FUNCTION v8_ret_dt(which VARCHAR(10)) RETURNS DATETIME LANGUAGE JS AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION mle_ret_dt(which VARCHAR(10)) RETURNS DATETIME LANGUAGE JAVASCRIPT AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION v8_ret_big(which VARCHAR(10)) RETURNS BIGINT UNSIGNED LANGUAGE JS AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION mle_ret_big(which VARCHAR(10)) RETURNS BIGINT UNSIGNED LANGUAGE JAVASCRIPT AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION v8_ret_text(which VARCHAR(10)) RETURNS TEXT LANGUAGE JS AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION mle_ret_text(which VARCHAR(10)) RETURNS TEXT LANGUAGE JAVASCRIPT AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION v8_ret_json(which VARCHAR(10)) RETURNS JSON LANGUAGE JS AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION mle_ret_json(which VARCHAR(10)) RETURNS JSON LANGUAGE JAVASCRIPT AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION v8_ret_dec(which VARCHAR(10)) RETURNS DECIMAL(10,4) LANGUAGE JS AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
CREATE FUNCTION mle_ret_dec(which VARCHAR(10)) RETURNS DECIMAL(10,4) LANGUAGE JAVASCRIPT AS $$ return { dt: new Date(Date.UTC(2024, 0, 2, 3, 4, 5)), big: 2n ** 64n - 1n, set: new Set(['a', 'c']), obj: { k: [1, 'x'] }, dec: 1 / 3 }[which] $$;
SET time_zone = '+00:00';
# js_lang: a Date becomes its string form, which MySQL does not take.
SELECT v8_ret_dt('dt') AS js_lang_date;
ERROR 22007: Incorrect datetime value: 'Tue Jan 02 2024 06:04:05 GMT+0300 (GMT)' for column 'js_lang_date' at row 1
# MLE (as Oracle): a Date is a DATETIME in local time (here mysqld's zone).
SELECT mle_ret_dt('dt') AS mle_date;
mle_date
2024-01-02 06:04:05
SELECT v8_ret_big('big') AS js_lang_bigint, mle_ret_big('big') AS mle_bigint;
js_lang_bigint	mle_bigint
18446744073709551615	18446744073709551615
SELECT v8_ret_text('set') AS js_lang_set, mle_ret_text('set') AS mle_set;
js_lang_set	mle_set
[object Set]	[object Set]
SELECT v8_ret_json('obj') AS js_lang_json, mle_ret_json('obj') AS mle_json;
js_lang_json	mle_json
{"k": [1, "x"]}	{"k": [1, "x"]}
SELECT v8_ret_dec('dec') AS js_lang_decimal, mle_ret_dec('dec') AS mle_decimal;
js_lang_decimal	mle_decimal
0.3333	0.3333
Warnings:
Note	1265	Data truncated for column 'js_lang_decimal' at row 1
Note	1265	Data truncated for column 'mle_decimal' at row 1
SET time_zone = DEFAULT;
#
# 3. Errors: what the client gets for a thrown Error; the trace.
#
CREATE FUNCTION v8_err(x INT) RETURNS INT LANGUAGE JS AS $$ function inner() { throw new Error('boom ' + x) }; inner() $$;
CREATE FUNCTION mle_err(x INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ function inner() { throw new Error('boom ' + x) }; inner() $$;
SELECT v8_err(1);
ERROR HY000: Error: boom 1
SELECT JS_GET_LAST_ERROR_INFO() AS js_lang_error_info;
js_lang_error_info
Error: Error: boom 1
At: SQL FUNCTION test.v8_err:1:20
Line:  function inner() { throw new Error('boom ' + x) }; inner() 
                          ^
Stack:
Error: boom 1
    at inner (SQL FUNCTION test.v8_err:1:27)
    at SQL FUNCTION test.v8_err:1:53
SELECT mle_err(1);
ERROR HY000: JavaScript> Error: boom 1
SELECT mle_session_state('stack_trace') AS mle_stack_trace;
mle_stack_trace
<js> mle_err:1:27-48
<js> mle_err:1:53-59

#
# 4. State between calls: js_lang keeps globalThis per connection and
#    user; MLE (as Oracle) gives each call a fresh globalThis.
#
CREATE FUNCTION v8_counter() RETURNS INT LANGUAGE JS AS $$ globalThis.n = (globalThis.n || 0) + 1; return globalThis.n $$;
CREATE FUNCTION mle_counter() RETURNS INT LANGUAGE JAVASCRIPT AS $$ globalThis.n = (globalThis.n || 0) + 1; return globalThis.n $$;
SELECT v8_counter(), v8_counter(), v8_counter();
v8_counter()	v8_counter()	v8_counter()
1	2	3
SELECT mle_counter(), mle_counter(), mle_counter();
mle_counter()	mle_counter()	mle_counter()
1	1	1
#
# 5. async: js_lang converts the returned Promise; MLE awaits it.
#
CREATE FUNCTION v8_async() RETURNS TEXT LANGUAGE JS AS $$ return (async () => { const v = await Promise.resolve(41); return v + 1 })() $$;
CREATE FUNCTION mle_async() RETURNS TEXT LANGUAGE JAVASCRIPT AS $$ const v = await Promise.resolve(41); return v + 1 $$;
SELECT v8_async() AS js_lang, mle_async() AS mle;
js_lang	mle
[object Promise]	42
#
# 6. Console output: per engine its own UDF.
#
CREATE PROCEDURE v8_log() LANGUAGE JS AS $$ console.log('hello', 42, [1, 2]) $$;
CREATE PROCEDURE mle_log() LANGUAGE JAVASCRIPT AS $$ console.log('hello', 42, [1, 2]) $$;
CALL v8_log();
CALL mle_log();
SELECT JS_GET_CONSOLE_LOG() AS js_lang_console, mle_session_state('stdout') AS mle_stdout;
js_lang_console	mle_stdout
hello 42 [object Array]
	hello 42 1,2

#
# 7. SQL from JavaScript: only MLE has an API (js_lang: none).
#
CREATE PROCEDURE v8_sql(OUT r TEXT) LANGUAGE JS AS $$ r = (() => { return typeof session === 'object' ? session.runSql('SELECT COUNT(*) AS n FROM information_schema.SCHEMATA').fetchOne().n > 0 : 'no session object' })() $$;
CREATE PROCEDURE mle_sql(OUT r TEXT) LANGUAGE JAVASCRIPT AS $$ r = (() => { return typeof session === 'object' ? session.runSql('SELECT COUNT(*) AS n FROM information_schema.SCHEMATA').fetchOne().n > 0 : 'no session object' })() $$;
CALL v8_sql(@a);
CALL mle_sql(@b);
SELECT @a AS js_lang, @b AS mle;
js_lang	mle
no session object	true
#
# 8. Deep recursion: V8's own stack limit; MLE's frame limit (Oracle's).
#
CREATE FUNCTION v8_deep(n INT) RETURNS INT LANGUAGE JS AS $$ const f = (k) => k === 0 ? 0 : 1 + f(k - 1); return f(n) $$;
CREATE FUNCTION mle_deep(n INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ const f = (k) => k === 0 ? 0 : 1 + f(k - 1); return f(n) $$;
SELECT v8_deep(500) AS js_lang_500, mle_deep(500) AS mle_500;
js_lang_500	mle_500
500	500
SELECT v8_deep(1000000);
ERROR HY000: RangeError: Maximum call stack size exceeded
SELECT mle_deep(1000000);
ERROR HY000: JavaScript> Maximum frame limit of 1000 exceeded. Frames on stack: 1001.
DROP FUNCTION v8_args;
DROP FUNCTION mle_args;
DROP FUNCTION v8_ret_dt;
DROP FUNCTION mle_ret_dt;
DROP FUNCTION v8_ret_big;
DROP FUNCTION mle_ret_big;
DROP FUNCTION v8_ret_text;
DROP FUNCTION mle_ret_text;
DROP FUNCTION v8_ret_json;
DROP FUNCTION mle_ret_json;
DROP FUNCTION v8_ret_dec;
DROP FUNCTION mle_ret_dec;
DROP FUNCTION v8_err;
DROP FUNCTION mle_err;
DROP FUNCTION v8_counter;
DROP FUNCTION mle_counter;
DROP FUNCTION v8_async;
DROP FUNCTION mle_async;
DROP PROCEDURE v8_log;
DROP PROCEDURE mle_log;
DROP PROCEDURE v8_sql;
DROP PROCEDURE mle_sql;
DROP FUNCTION v8_deep;
DROP FUNCTION mle_deep;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_JS_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_lang_router";
UNINSTALL COMPONENT "file://component_mle";
UNINSTALL COMPONENT "file://component_js_lang";
# js_lang cannot be installed again without a restart (V8).
# restart
