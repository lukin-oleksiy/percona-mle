--echo #
--echo # component_mle: workers kept for later sessions of the same account
--echo # (mle.worker_cache_size, mle.worker_cache_timeout; 12 §17). A kept worker
--echo # was reset: no routines; its runtime stays warm.
--echo #
--source include/have_mle_component.inc
--source include/have_debug.inc
--source include/count_sessions.inc

INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* TO root@localhost;
CREATE USER u1@localhost;
GRANT EXECUTE ON test.* TO u1@localhost;
SELECT @@mle.worker_cache_size, @@mle.worker_cache_timeout;
let $reuses0 = query_get_value(SHOW GLOBAL STATUS LIKE 'mle_worker_reuses', Value, 1);

--echo # A session uses a worker and ends: the worker is kept.
--connect (con1, localhost, root,,test)
CREATE FUNCTION js_add(a INT, b INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$ return a + b $$;
CREATE FUNCTION js_inv(a INT) RETURNS INT SQL SECURITY INVOKER LANGUAGE JAVASCRIPT AS $$ return a $$;
CREATE FUNCTION py_leftover(v VARCHAR(10)) RETURNS VARCHAR(40) LANGUAGE PYTHON AS $$
    import builtins
    old = getattr(builtins, 'mle_leftover', None)
    builtins.mle_leftover = v
    return 'found ' + str(old)
$$;
SELECT js_add(1, 2), py_leftover('one');
let $pid1 = `SELECT mle_debug_worker_pid()`;
--disconnect con1
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # The next session of the same account gets it: the same process, its
--echo # routines prepared again. State in the languages' own modules stays
--echo # (same account, same privileges; documented).
--connect (con2, localhost, root,,test)
SELECT js_add(2, 3), py_leftover('two');
let $pid2 = `SELECT mle_debug_worker_pid()`;
let $same = `SELECT $pid1 = $pid2`;
--echo same worker process: $same
let $reuses = query_get_value(SHOW GLOBAL STATUS LIKE 'mle_worker_reuses', Value, 1);
let $more = `SELECT $reuses - $reuses0`;
--echo reuses: $more

--echo # Another account does not get it (an INVOKER routine runs as u1).
--connect (con3, localhost, u1,,test)
SELECT js_inv(7);
let $pid3 = `SELECT mle_debug_worker_pid()`;
let $other = `SELECT $pid3 <> $pid2`;
--echo another process for u1: $other
--disconnect con3
--disconnect con2
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc

--echo # Kept workers end after mle.worker_cache_timeout.
SET GLOBAL mle.worker_cache_timeout = 1;
let $wait_condition = SELECT VARIABLE_VALUE = 0 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc
SET GLOBAL mle.worker_cache_timeout = DEFAULT;

--echo # mle.worker_cache_size = 0: a session's workers end with it.
SET GLOBAL mle.worker_cache_size = 0;
--connect (con4, localhost, root,,test)
SELECT js_add(4, 5);
--disconnect con4
--connection default
--source include/wait_until_count_sessions.inc
SELECT VARIABLE_VALUE AS kept FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
SET GLOBAL mle.worker_cache_size = DEFAULT;

--echo # UNINSTALL ends kept workers.
--connect (con5, localhost, root,,test)
SELECT js_add(5, 6);
--disconnect con5
--connection default
let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mle_workers_cached';
--source include/wait_condition.inc
--source include/wait_until_count_sessions.inc
DROP FUNCTION js_add;
DROP FUNCTION js_inv;
DROP FUNCTION py_leftover;
DROP USER u1@localhost;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
