#
# component_mle: the statistics helper com.percona.mle.api.Stats (exp note
# 54): what MySQL has no SQL for (percentiles, median, mode, summary,
# histogram, correlation, covariance, linear regression with p-values,
# z-scores, outliers, ranks), on columns and on a Frame from SQL, per group;
# against values computed with numpy 2, pandas 3.1 and scipy 1.18; from Java,
# JavaScript and Python.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* TO root@localhost;
CREATE TABLE sales (id INT PRIMARY KEY, region VARCHAR(8), price DOUBLE, qty INT);
INSERT INTO sales VALUES (1, 'n', 10, 1), (2, 's', 12.5, 2), (3, 'n', 11, 3), (4, 'e', 30, 4), (5, 's', 9, 5),
(6, 'n', NULL, 6), (7, 'e', 31, 7), (8, 's', 14, 8), (9, 'n', 13.5, 9), (10, NULL, 7, 10);
# 1. Against numpy, pandas and scipy.
SELECT stats_selfcheck() AS selfcheck;
selfcheck
ok
# 2. A Frame from SQL, per group; Java, JavaScript, Python.
