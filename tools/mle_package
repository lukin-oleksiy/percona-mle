"""mle_package: third-party packages for MLE routines (component_mle).

Run by the DBA on the database host, as an OS user who may write the package
directory (mle.package_dir; default <mle.dir>/packages). mysqld and its
workers only read it; regular database users cannot add packages.

  mle_package [--dir DIR] install js     lodash@4.17.21 date-fns
  mle_package [--dir DIR] install python pandas networkx
  mle_package [--dir DIR] install java   org.apache.commons:commons-math3:3.6.1
  mle_package [--dir DIR] install cpython pandas         (the CPython worker)
  mle_package [--dir DIR] remove  js|python|cpython|java NAME...
  mle_package [--dir DIR] list

Then, in mysqld: SELECT mle_packages_refresh();  (new workers see the change)

Layout: js/ (npm --prefix: node_modules, package.json), python/site-packages
(pip --target with GraalPy, using GraalPy's binary wheels where they exist),
java/*.jar (Maven, with dependencies; java/mle_package.json keeps what was
asked for), cpython/site-packages (pip --target with the CPython the CPython
worker embeds: mle.worker = CPYTHON). packages.json lists what is installed.

Python packages need a GraalPy of the workers' version with pip (--graalpy):
the packages do not bring one (README, "Install and packages"). Packages for
the CPython worker need that Python with its venv module (python3-venv): its
version is in <mle dir>/cpython/python-version (--cpython to give another).
"""

import argparse
import csv
import datetime
import fcntl
import glob
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from xml.sax.saxutils import escape

# The MLE directory the tool is started from (the build layout links it).
HERE = os.path.dirname(os.path.abspath(__file__))
GRAALPY_WHEELS = "https://www.graalvm.org/python/wheels/"


def run(cmd, **kw):
    print("+ " + " ".join(cmd), file=sys.stderr)
    subprocess.run(cmd, check=True, **kw)


def graalpy(args):
    if args.graalpy:
        return args.graalpy
    # The venv's GraalPy exists in a build tree only: the packages install the
    # venv without its bin/ (worker/CMakeLists.txt).
    for c in (os.path.join(HERE, "python-venv", "venv", "bin", "graalpy"),
              shutil.which("graalpy") or ""):
        if c and os.access(c, os.X_OK):
            return c
    version = ""
    for jar in glob.glob(os.path.join(HERE, "deps", "python-language-*.jar")):
        version = " " + os.path.basename(jar)[len("python-language-"):-len(".jar")]
    sys.exit("mle_package: no GraalPy found. Python packages must be installed with a "
             "GraalPy of the workers' version%s: give the graalpy of a venv made with "
             "one (graalpy -m venv DIR) as --graalpy DIR/bin/graalpy" % version)


def cpython(args):
    """The interpreter of the CPython worker's version (python3.X), for pip."""
    if args.cpython:
        return args.cpython
    try:
        with open(os.path.join(HERE, "cpython", "python-version")) as f:
            version = f.read().strip()
    except OSError:
        sys.exit("mle_package: the CPython worker is not installed here (%s); give its Python "
                 "as --cpython" % os.path.join(HERE, "cpython"))
    found = shutil.which("python" + version)
    if not found:
        sys.exit("mle_package: python%s (the CPython worker's version) is not on PATH; give it "
                 "as --cpython" % version)
    return found


def site_dir(d, language):
    return os.path.join(d, "cpython" if language == "cpython" else "python", "site-packages")


def inside(path, d):
    return os.path.commonpath([path, d]) == d


def write_json(directory, name, data):
    # Every database user can read the manifest (mle_packages()): no OS user names.
    fd, tmp = tempfile.mkstemp(prefix="." + name + ".", dir=directory)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(directory, name))


# ---------------------------------------------------------------- safety

def unsafe(d):
    """What lets another OS user change the files workers run: the reasons."""
    bad = []
    owners = (os.geteuid(), 0)

    def check(path):
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode):
            if not inside(os.path.realpath(path), d):
                bad.append(path + " is a symbolic link out of the package directory")
            return
        if st.st_uid not in owners:
            bad.append("%s belongs to another OS user (uid %d)" % (path, st.st_uid))
        if st.st_mode & 0o022:
            bad.append(path + " is writable by its group or by others (chmod go-w)")

    check(d)
    for root, dirs, files in os.walk(d):  # does not follow links
        for name in dirs + files:
            check(os.path.join(root, name))
    return bad


def require_safe(d, when):
    bad = unsafe(d)
    if bad:
        more = ["... and %d more" % (len(bad) - 10)] if len(bad) > 10 else []
        sys.exit("mle_package: %s: MLE workers run what is in %s, so only this OS user "
                 "(or root) may be able to change it:\n  %s" % (when, d, "\n  ".join(bad[:10] + more)))


# ---------------------------------------------------------------- install

def install_js(d, specs, args):
    os.makedirs(os.path.join(d, "js"), exist_ok=True)
    # Package lifecycle scripts would run third-party code as this OS user.
    scripts = [] if args.allow_scripts else ["--ignore-scripts"]
    run(["npm", "install", "--prefix", os.path.join(d, "js"), "--no-audit",
         "--no-fund", "--save-exact", *scripts, *specs])


def merge_tree(src, dst):
    """Moves what is in src into dst (the same file system), replacing files."""
    for name in os.listdir(src):
        s, t = os.path.join(src, name), os.path.join(dst, name)
        s_dir = os.path.isdir(s) and not os.path.islink(s)
        t_dir = os.path.isdir(t) and not os.path.islink(t)
        if s_dir and t_dir:
            merge_tree(s, t)
            continue
        if t_dir:
            shutil.rmtree(t)
        elif s_dir and os.path.lexists(t):
            os.remove(t)
        os.replace(s, t)


def install_python(d, specs, args, language="python"):
    site = site_dir(d, language)
    os.makedirs(site, exist_ok=True)
    site = os.path.realpath(site)
    # Wheels only: building a source distribution runs its setup code as this
    # OS user (--allow-source to permit it).
    binary = ["--prefer-binary"] if args.allow_source else ["--only-binary=:all:"]
    # pip --target --upgrade into site-packages would leave the .dist-info of
    # a replaced version, and the files the new version no longer has. So pip
    # installs into an empty directory beside it; then what it installed
    # replaces the versions site-packages has.
    # The worker's own site-packages (numpy) is on its path too (GraalPy's venv, the CPython
    # worker's site-packages): pip must resolve against those versions, and need not install them
    # again (pip --target does not see them by itself); a copy in the package directory would
    # shadow them (MVP review OPS-2).
    if language == "python":
        bundled = {}
        for venv_site in glob.glob(os.path.join(HERE, "python-venv", "venv", "lib", "python*", "site-packages")):
            bundled.update(python_dists(venv_site))
    else:
        bundled = python_dists(os.path.join(HERE, "cpython", "site-packages"))
    with tempfile.TemporaryDirectory(prefix=".stage.", dir=os.path.dirname(site)) as stage, \
            tempfile.TemporaryDirectory(prefix="mle-pip.") as work:
        constraints = os.path.join(work, "bundled.txt")
        with open(constraints, "w") as f:
            f.writelines("%s==%s\n" % (name, dists[0][1]) for name, dists in bundled.items())
        if language == "python":
            run([graalpy(args), "-m", "pip", "install", "--disable-pip-version-check",
                 *binary, "--target", stage, "--constraint", constraints,
                 "--extra-index-url", GRAALPY_WHEELS,
                 *specs])
        else:
            # The distribution's pip refuses to install for its Python (PEP 668):
            # a throw-away venv's pip, into the stage directory.
            venv = os.path.join(work, "venv")
            run([cpython(args), "-m", "venv", venv])
            run([os.path.join(venv, "bin", "pip"), "install", "--disable-pip-version-check",
                 *binary, "--target", stage, "--constraint", constraints, *specs])
        shutil.rmtree(os.path.join(stage, "bin"), ignore_errors=True)  # scripts name pip's interpreter
        for name, dists in python_dists(stage).items():
            if name in bundled:
                remove_python(stage, name, [info for info, _ in dists])
        have = python_dists(site)
        for name in python_dists(stage):
            if name in have:
                remove_python(site, name, [info for info, _ in have[name]])
        merge_tree(stage, site)


# What mle_package was asked to install ("requested": group:artifact ->
# version) and the jars Maven resolved for it ("resolved": file names).
JAVA_RECORD = "mle_package.json"


def java_record(d):
    path = os.path.join(d, "java", JAVA_RECORD)
    try:
        with open(path) as f:
            record = json.load(f)
        return {"requested": dict(record["requested"]), "resolved": list(record["resolved"])}
    except FileNotFoundError:
        return None
    except (OSError, ValueError, KeyError, TypeError):
        sys.exit("mle_package: cannot read " + path)


def install_java(d, specs):
    out = os.path.join(d, "java")
    record = java_record(d)
    if record is None:
        if glob.glob(os.path.join(out, "*.jar")):
            sys.exit("mle_package: %s has jars but no %s (jars of an earlier mle_package, or "
                     "copied there): which packages they are is not known. Move them away, "
                     "install the packages again, then copy back the jars that are not from "
                     "Maven" % (out, JAVA_RECORD))
        record = {"requested": {}, "resolved": []}
    requested = record["requested"]
    for s in specs:
        parts = s.split(":")
        if len(parts) != 3 or not all(re.fullmatch(r"[A-Za-z0-9_.\-]+", p) for p in parts):
            sys.exit("mle_package: a Java package is group:artifact:version, not " + s)
        requested[parts[0] + ":" + parts[1]] = parts[2]  # one version of a package
    deps = []
    for ga, version in sorted(requested.items()):
        deps.append("<dependency><groupId>%s</groupId><artifactId>%s</artifactId>"
                    "<version>%s</version></dependency>"
                    % tuple(escape(p) for p in ga.split(":") + [version]))
    # Maven resolves everything that was asked for, now and before, into a new
    # directory: one version of each artifact (by group, artifact and
    # classifier, not by file name), no jar left of a version or a dependency
    # that is not needed any more. Then the new directory replaces java/.
    stage = tempfile.mkdtemp(prefix=".java.", dir=d)
    try:
        with tempfile.TemporaryDirectory() as tmp:
            with open(os.path.join(tmp, "pom.xml"), "w") as f:
                f.write('<project xmlns="http://maven.apache.org/POM/4.0.0">'
                        "<modelVersion>4.0.0</modelVersion><groupId>mle</groupId>"
                        "<artifactId>packages</artifactId><version>1</version>"
                        "<dependencies>%s</dependencies></project>" % "".join(deps))
            run(["mvn", "-q", "-B", "-f", os.path.join(tmp, "pom.xml"),
                 "dependency:copy-dependencies", "-DincludeScope=runtime",
                 "-DoutputDirectory=" + stage])
        resolved = sorted(os.listdir(stage))
        # Jars that are not from Maven (copied into java/ by the DBA) stay.
        for jar in sorted(glob.glob(os.path.join(out, "*.jar"))):
            name = os.path.basename(jar)
            if name not in record["resolved"] and name not in resolved and os.path.isfile(jar):
                shutil.copyfile(jar, os.path.join(stage, name))
        write_json(stage, JAVA_RECORD, {"requested": requested, "resolved": resolved})
        os.chmod(stage, 0o755)
        old = stage + ".old"
        if os.path.lexists(out):
            os.rename(out, old)
        try:
            os.rename(stage, out)
        except OSError:
            if os.path.lexists(old):
                os.rename(old, out)
            raise
        shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


# ---------------------------------------------------------------- inventory

def js_packages(d):
    try:
        with open(os.path.join(d, "js", "package.json")) as f:
            deps = json.load(f).get("dependencies", {})
    except (OSError, ValueError):
        return []
    out = []
    for name in sorted(deps):
        try:
            with open(os.path.join(d, "js", "node_modules", name, "package.json")) as f:
                version = json.load(f).get("version", "")
        except (OSError, ValueError):
            version = deps[name]
        out.append({"language": "js", "name": name, "version": version})
    return out


def python_name(name):
    # The normalised name (PyPA): pip takes "-", "_" and "." in a name as the
    # same, and a .dist-info directory may spell it with any of them.
    return re.sub(r"[-_.]+", "-", name).lower()


def python_dists(site):
    """Normalised name -> [(.dist-info directory, version)]."""
    out = {}
    for info in sorted(glob.glob(os.path.join(site, "*.dist-info"))):
        m = re.match(r"(.+)-([^-]+)\.dist-info$", os.path.basename(info))
        if m:
            out.setdefault(python_name(m.group(1)), []).append((info, m.group(2)))
    return out


def python_packages(d, language="python"):
    dists = python_dists(site_dir(d, language))
    return [{"language": language, "name": name, "version": version}
            for name in sorted(dists) for _, version in dists[name]]


JAR = re.compile(r"(.+?)-(\d[^/]*)\.jar$")


def java_jars(d):
    """[(jar, name, version)]. Maven names a jar artifact-version[-classifier]:
    the split is known for what was asked for, a guess for dependencies."""
    known = {}
    for ga, version in ((java_record(d) or {}).get("requested", {})).items():
        artifact = ga.split(":")[1]
        known["%s-%s.jar" % (artifact, version)] = (artifact, version)
    out = []
    for jar in sorted(glob.glob(os.path.join(d, "java", "*.jar"))):
        base = os.path.basename(jar)
        m = JAR.match(base)
        name, version = known.get(base) or ((m.group(1), m.group(2)) if m else (base, ""))
        out.append((jar, name, version))
    return out


def java_packages(d):
    return [{"language": "java", "name": name, "version": version}
            for _, name, version in java_jars(d)]


def inventory(d):
    return js_packages(d) + python_packages(d) + python_packages(d, "cpython") + java_packages(d)


def write_manifest(d):
    data = {"updated": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
            "packages": inventory(d)}
    write_json(d, "packages.json", data)


# ---------------------------------------------------------------- remove

def remove_python(site, name, infos):
    """Removes the files of a package (normalised name; its .dist-info directories)."""
    dirs = set()
    for info in infos:
        record = os.path.join(info, "RECORD")
        if os.path.exists(record):
            with open(record, newline="") as f:
                for row in csv.reader(f):
                    if not row:
                        continue
                    path = os.path.realpath(os.path.join(site, row[0]))
                    # Only files inside site-packages (RECORD comes with the package).
                    if inside(path, site) and path != site and os.path.isfile(path):
                        os.remove(path)
                        dirs.add(os.path.dirname(path))
        shutil.rmtree(info, ignore_errors=True)
    # Directories left empty (deepest first): no empty namespace packages.
    for left in sorted(dirs | {os.path.join(site, name.replace("-", "_"))}, key=len, reverse=True):
        while (left != site and inside(left, site) and
               os.path.isdir(left) and not os.listdir(left)):
            os.rmdir(left)
            left = os.path.dirname(left)


def remove(d, language, names):
    for n in names:
        if not re.fullmatch(r"[A-Za-z0-9_.@/\-]+", n) or ".." in n or (language != "js" and "/" in n):
            sys.exit("mle_package: not a package name: " + n)
    if language == "js":
        run(["npm", "uninstall", "--prefix", os.path.join(d, "js"), *names])
        return
    # Every name is looked up before anything is removed: all or nothing.
    if language == "java":
        jars = java_jars(d)
        doomed = []
        for n in names:
            found = [jar for jar, name, _ in jars if name == n]
            if not found:
                sys.exit("mle_package: no Java package " + n)
            doomed += found
        for jar in set(doomed):
            os.remove(jar)
        record = java_record(d)
        if record is not None:
            # Not asked for any more: a later install does not bring it back
            # (but as a dependency of another package).
            record["requested"] = {ga: v for ga, v in record["requested"].items()
                                   if ga.split(":")[1] not in names}
            gone = {os.path.basename(jar) for jar in doomed}
            record["resolved"] = [name for name in record["resolved"] if name not in gone]
            write_json(os.path.join(d, "java"), JAVA_RECORD, record)
        return
    site = os.path.realpath(site_dir(d, language))
    dists = python_dists(site)
    for n in names:
        if python_name(n) not in dists:
            sys.exit("mle_package: no Python package " + n)
    for name in {python_name(n) for n in names}:
        remove_python(site, name, [info for info, _ in dists[name]])


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--dir", default=os.environ.get("MLE_PACKAGE_DIR", os.path.join(HERE, "packages")),
                   help="the package directory (mle.package_dir)")
    p.add_argument("--graalpy",
                   help="GraalPy (with pip) for Python packages, of the workers' version; default: "
                        "a build tree's venv, else graalpy on PATH (the packages bring none)")
    p.add_argument("--cpython",
                   help="the Python (with venv) for the CPython worker's packages; default: "
                        "python3.X of the worker's version on PATH")
    p.add_argument("--allow-scripts", action="store_true",
                   help="run npm packages' install scripts (they run as this OS user)")
    p.add_argument("--allow-source", action="store_true",
                   help="let pip build source distributions (their setup code runs as this OS user)")
    sub = p.add_subparsers(dest="cmd", required=True)
    for c in ("install", "remove"):
        s = sub.add_parser(c)
        s.add_argument("language", choices=["js", "python", "cpython", "java"])
        s.add_argument("names", nargs="+")
    sub.add_parser("list")
    args = p.parse_args()
    d = os.path.realpath(args.dir)
    if args.cmd == "list":  # reads only: no directory, nothing installed
        for pkg in inventory(d):
            print("%-7s %-30s %s" % (pkg["language"], pkg["name"], pkg["version"]))
        return
    # Workers read these files: nobody but this OS user may change them.
    os.umask(0o022)
    if args.cmd == "install":
        os.makedirs(d, exist_ok=True)
    elif not os.path.isdir(d):
        sys.exit("mle_package: no package directory " + d)
    require_safe(d, "nothing was changed")
    # One install or remove at a time: each rewrites the records and the java/ tree from what it
    # read (MVP review OPS-11). The lock is held until the process ends.
    lock = os.open(os.path.join(d, ".mle_package.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("mle_package: another mle_package runs on %s; waiting for it" % d, file=sys.stderr)
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if args.cmd == "install":
            {"js": lambda: install_js(d, args.names, args),
             "python": lambda: install_python(d, args.names, args),
             "cpython": lambda: install_python(d, args.names, args, "cpython"),
             "java": lambda: install_java(d, args.names)}[args.language]()
        else:
            remove(d, args.language, args.names)
    finally:
        # Also after a failure half way: the manifest says what is there.
        write_manifest(d)
    require_safe(d, "after the " + args.cmd)
    print("Done. In mysqld: SELECT mle_packages_refresh();", file=sys.stderr)


if __name__ == "__main__":
    main()
