--echo #
--echo # component_mle: INSTALL fails clearly when the engine cannot start
--echo # (no half-working component), and a server whose installed component
--echo # cannot start comes up without it.
--echo #
--source include/have_mle_component.inc
--source include/not_valgrind.inc

call mtr.add_suppression("Component mle reported: 'Cannot install: ");
call mtr.add_suppression("MY-006000 - MLE: cannot install the component");
call mtr.add_suppression("MY-003536 - Initialization method provided by component 'mle' failed");
call mtr.add_suppression("Failed to load components from mysql.component");

--echo # 1. The MLE files are not in mle.dir.
--let $restart_parameters = restart: --loose-mle.dir=$MYSQL_TMP_DIR/no-mle
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--source include/restart_mysqld.inc
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--error ER_LANGUAGE_COMPONENT
INSTALL COMPONENT "file://component_mle";
SELECT COUNT(*) AS installed FROM mysql.component
  WHERE component_urn = 'file://component_mle';
SELECT COUNT(*) AS mle_variables FROM performance_schema.global_variables
  WHERE VARIABLE_NAME LIKE 'mle.%';
--echo # Without a language component the server stores the routine with a
--echo # warning.
CREATE FUNCTION f() RETURNS INT LANGUAGE JAVASCRIPT AS $$ return 1 $$;
DROP FUNCTION f;

--echo # 2. mle.java_home is not a GraalVM JDK.
--let $restart_parameters = restart: --loose-mle.java_home=$MYSQL_TMP_DIR/no-jdk
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--source include/restart_mysqld.inc
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--error ER_LANGUAGE_COMPONENT
INSTALL COMPONENT "file://component_mle";

--echo # 3. Installed (persisted in mysql.component), then the server restarts
--echo #    without the files: it starts, logs why MLE is not there.
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
INSTALL COMPONENT "file://component_mle";
--let $restart_parameters = restart: --loose-mle.dir=$MYSQL_TMP_DIR/no-mle
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--source include/restart_mysqld.inc
SELECT COUNT(*) AS mle_status_vars FROM performance_schema.global_status
  WHERE VARIABLE_NAME LIKE 'mle%';
--echo # Without a language component the server stores the routine with a
--echo # warning.
CREATE FUNCTION f() RETURNS INT LANGUAGE JAVASCRIPT AS $$ return 1 $$;
DROP FUNCTION f;

--let $assert_text = The error log says why MLE did not start
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select = Component mle reported: 'Cannot install: the MLE files are not installed in mle.dir
--let $assert_count = 2
--let $assert_only_after = CURRENT_TEST: component_mle.install_errors
--let $assert_match =
--source include/assert_grep.inc
--let $assert_text = and that the JDK is missing
--let $assert_select = Component mle reported: 'Cannot install: mle.java_home .* is not a GraalVM JDK 25
--let $assert_count = 1
--source include/assert_grep.inc

--echo # With the files back, the persisted component is loaded at startup.
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
SELECT VARIABLE_VALUE AS mle_status FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'mle_status';
UNINSTALL COMPONENT "file://component_mle";
