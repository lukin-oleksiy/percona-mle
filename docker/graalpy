#!/bin/sh
# GraalPy from the jars in /opt/graalpy/lib, on the GraalVM runtime of MLE.
exec /usr/local/mysql/lib/plugin/mle/jdk/bin/java --enable-native-access=ALL-UNNAMED \
  --sun-misc-unsafe-memory-access=allow -cp "/opt/graalpy/lib/*" \
  com.oracle.graal.python.shell.GraalPythonMain --python.Executable="$0" "$@"
