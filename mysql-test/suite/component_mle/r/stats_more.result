#
# component_mle: the statistics helper's second round (exp note 75): rolling
# windows, median absolute deviation, t-tests, the REGR_* sums, more per-group
# aggregates, Frame.with; time series: bucket, gapFill, seconds, timeSeries.
# Against values computed with pandas 3.1.1 and scipy 1.18.1; from Java,
# JavaScript and Python.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* TO root@localhost;
CREATE TABLE readings (ts DATETIME, sensor VARCHAR(4), v DOUBLE);
INSERT INTO readings VALUES ('2026-11-27 10:00:00', 'a', 1), ('2026-11-27 10:01:00', 'a', 2),
('2026-11-27 10:04:00', 'a', 5), ('2026-11-27 10:05:30', 'a', 8), ('2026-11-27 10:07:00', 'a', NULL),
('2026-11-27 10:08:00', 'a', 10), ('2026-11-27 10:00:00', 'b', 100), ('2026-11-27 10:03:00', 'b', 130),
(NULL, 'b', 999);
CREATE TABLE days (d DATE, amount INT);
INSERT INTO days VALUES ('2026-01-05', 1), ('2026-01-11', 2), ('2026-01-12', 3), ('2026-02-28', 4),
('2026-03-01', 5), ('2026-04-15', 6), ('2025-12-31', 7);
CREATE TABLE ticks (t TIMESTAMP(3), price DOUBLE);
INSERT INTO ticks VALUES ('2026-11-27 09:59:59.950', 10), ('2026-11-27 10:00:00.100', 11),
('2026-11-27 10:00:00.450', 12), ('2026-11-27 10:00:00.700', 13);
# 1. Against pandas and scipy; many rows over threads against a direct computation.
SELECT stats_more_selfcheck() AS selfcheck;
selfcheck
ok
# 2. Time series: buckets, gap filling, seconds, series; Java, JavaScript, Python.
