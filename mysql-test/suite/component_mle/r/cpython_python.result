#
# component_mle: the CPython worker (exp design note 62; mle.worker =
# CPYTHON, the distribution's CPython embedded in mle_cpython_worker).
# Python routines, numpy, the SQL API, VECTOR values, Python libraries,
# mle_eval and the CREATE check; JavaScript and Java refused; the sandbox,
# KILL, a native crash and the cgroup memory limit as with the JVM build.
#
call mtr.add_suppression("Component mle reported: 'The worker of .* was (lost|retired)");
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_PYTHON_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
#
# 1. The CPython worker runs Python only.
#
SELECT @@mle.worker;
@@mle.worker
CPYTHON
SELECT VARIABLE_VALUE AS languages FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_languages_supported';
languages
Python
CREATE FUNCTION js_f() RETURNS INT LANGUAGE JAVASCRIPT AS $$ return 1 $$;
ERROR HY000: Language component: Unsupported language 'JAVASCRIPT'
CREATE FUNCTION java_f() RETURNS INT LANGUAGE JAVA AS $$ return 1; $$;
ERROR HY000: Language component: Unsupported language 'JAVA'
CREATE LIBRARY jslib LANGUAGE JAVASCRIPT AS $$ export function f() { return 1 } $$;
ERROR HY000: Libraries are not supported for JAVASCRIPT.
#
# 2. Python routines, numpy, the SQL API, VECTOR values, libraries.
#
CREATE TABLE items (id INT PRIMARY KEY, name VARCHAR(20), price DECIMAL(8,2), v VECTOR(3));
INSERT INTO items VALUES (1, 'apple', 0.50, STRING_TO_VECTOR('[1, 0, 0]')),
(2, 'pear', 0.75, STRING_TO_VECTOR('[0.9, 0.1, 0]')), (3, 'car', 9000, STRING_TO_VECTOR('[0, 0, 1]'));
SELECT py_add(2, 3), py_np(), py_runtime();
py_add(2, 3)	py_np()	py_runtime()
5	[[5.0, 14.0], [14.0, 50.0]] 5.0	CPython 3.14, numpy 2.x
SELECT py_types(18446744073709551615, 12.345, 'héllo', '2026-11-19 12:34:56', '-838:59:59', '{"a": [1, 2]}',
0x41ff, 1.5) AS t;
t
(18446744073709551615, Decimal('12.345'), 'héllo', datetime.datetime(2026, 11, 19, 12, 34, 56), datetime.timedelta(days=-35, seconds=3601), {'a': [1, 2]}, b'A\xff', 1.5)
SELECT id, py_cosine(v, STRING_TO_VECTOR('[1, 0.05, 0]')) AS cosine FROM items ORDER BY id;
id	cosine
1	0.9988
2	0.9982
3	0
SELECT py_vec_ro(v) FROM items WHERE id = 1;
py_vec_ro(v)
read-only: assignment destination is read-only
SELECT VECTOR_TO_STRING(py_double(v)) FROM items ORDER BY id;
VECTOR_TO_STRING(py_double(v))
[2.00000e+00,0.00000e+00,0.00000e+00]
[1.80000e+00,2.00000e-01,0.00000e+00]
[0.00000e+00,0.00000e+00,2.00000e+00]
CALL py_sql(@r);
SELECT @r;
@r
1 apple 0.50 [1.0, 0.0, 0.0]
2 pear 0.75 [0.9, 0.1, 0.0]
3 car 9000.00 [0.0, 0.0, 1.0]
cheap: apple,pear
columns: (3, 3) float32 [1, 2, 3]
after rollback: 3
row by label: 7 8, by index: 8, values: [7, 8]
CALL py_nested(@r);
SELECT @r;
@r
2,4,6
CALL py_sqlerr();
ERROR 45001: caught 1146 42S02
SELECT py_vat(price), py_vat2(price) FROM items ORDER BY id;
py_vat(price)	py_vat2(price)
0.6	0.55
0.91	0.83
10890	9900
# Routine globals are fresh in every call; state lives in libraries.
SELECT py_state();
py_state()
routine global 1, library state 1
SELECT py_state();
py_state()
routine global 1, library state 2
# A library changed by DDL is used in its new version.
DROP LIBRARY pycounter;
CREATE LIBRARY pycounter LANGUAGE PYTHON AS $$bump = lambda: 100$$;
SELECT py_state();
py_state()
routine global 1, library state 100
SELECT py_thread();
py_thread()
threads are not available in MLE routines
SELECT py_print();
py_print()
1
SELECT py_err(1);
ERROR HY000: Python> ZeroDivisionError: division by zero (py_err, line 3, in helper)
SELECT py_range(-1);
ERROR HY000: MLE-Type> value -1 is out of range for BIGINT in 'py_range(-1)'
# A value Python cannot hold (a zero date) is the call's conversion error.
SET @old_mode = @@sql_mode;
SET sql_mode = '';
CREATE TABLE zero_dates (d DATETIME);
INSERT INTO zero_dates VALUES ('0000-00-00 00:00:00');
SELECT py_types(1, 1, 'a', d, '00:00:00', 'null', '', 0) FROM zero_dates;
ERROR HY000: MLE-Type> the DATETIME value 0000-00-00 0:00:00.000000 has no Python equivalent (zero date?) in 'py_types(1, 1.000, 'a', '0000-00-00 00:00:00.000000', '0:00:00.000000', 'null', ..., 0)'
SET sql_mode = @old_mode;
SELECT py_add(1, 2);
py_add(1, 2)
3
DROP TABLE zero_dates;
# A third-party package installed by the DBA (mle.package_dir).
SELECT py_package(1, 2, 6);
py_package(1, 2, 6)
1.0.0 3.00 5.00
SELECT py_probe();
py_probe()
read /etc/passwd: refused, write /tmp: refused, socket: refused, fork: refused, signal the parent: refused
# Process creation is refused by the seccomp filter.
SELECT py_spawn();
ERROR HY000: Python> (process creation refused)
# mle_eval and the CREATE check.
SELECT mle_eval('python', 'import numpy as np\nnp.arange(5) * 2') AS python;
python
array([0, 2, 4, 6, 8])
SELECT mle_eval('python', 'print("hello")\n6 * 7') AS printed_and_value;
printed_and_value
hello
42
SELECT mle_eval('python', 'a = 1\nb = 0\na / b');
ERROR HY000: Python> ZeroDivisionError: division by zero (mle_eval, line 3)
CREATE FUNCTION py_typo(word VARCHAR(20)) RETURNS INT LANGUAGE PYTHON AS $$
n = 0
return lenght(word) + n
$$;
Warnings:
Warning	6000	Python> py_typo, line 3: name 'lenght' is not defined
DROP FUNCTION py_typo;
#
# 3. max_execution_time and KILL QUERY stop a Python loop; the worker stays.
#
SELECT /*+ MAX_EXECUTION_TIME(500) */ py_loop();
ERROR HY000: Query execution was interrupted, maximum statement execution time exceeded
SELECT py_loop();
KILL QUERY CON1;
ERROR 70100: Query execution was interrupted
SELECT py_add(1, 1);
py_add(1, 1)
2
include/assert.inc [The same worker after the timeout and KILL QUERY]
#
# 4. A native crash ends the worker, not mysqld; the next call gets a new one.
#
SELECT py_crash();
ERROR HY000: MLE> the worker died: <reason>
SELECT py_add(20, 22);
py_add(20, 22)
42
include/assert.inc [A new worker after the crash]
#
# 5. Memory: numpy frees at once (no memory watcher needed), and the
#    cgroup limit (mle.memory_max) ends a worker that goes beyond it.
#
SELECT py_hog(256) AS ones;
ones
33554432
SELECT py_hog(256) + py_hog(256) + py_hog(256) + py_hog(256) + py_hog(256) + py_hog(256) + py_hog(256)
+ py_hog(256) + py_hog(256) + py_hog(256) AS many;
many
335544320
SELECT py_hog(4096);
ERROR HY000: MLE> the worker died: killed by the out-of-memory killer (cgroup memory limit)
SELECT VARIABLE_VALUE >= 1 AS oom_counted FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_oom_errors';
oom_counted
1
SELECT py_add(40, 2);
py_add(40, 2)
42
DROP FUNCTION py_add;
DROP FUNCTION py_np;
DROP FUNCTION py_runtime;
DROP FUNCTION py_types;
DROP FUNCTION py_cosine;
DROP FUNCTION py_vec_ro;
DROP FUNCTION py_double;
DROP PROCEDURE py_sql;
DROP FUNCTION py_twice;
DROP PROCEDURE py_nested;
DROP PROCEDURE py_sqlerr;
DROP FUNCTION py_vat;
DROP FUNCTION py_vat2;
DROP LIBRARY pyprices;
DROP FUNCTION py_state;
DROP LIBRARY pycounter;
DROP FUNCTION py_thread;
DROP FUNCTION py_print;
DROP FUNCTION py_err;
DROP FUNCTION py_range;
DROP FUNCTION py_loop;
DROP FUNCTION py_probe;
DROP FUNCTION py_spawn;
DROP FUNCTION py_package;
DROP FUNCTION py_crash;
DROP FUNCTION py_hog;
DROP TABLE items;
REVOKE CREATE_PYTHON_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
