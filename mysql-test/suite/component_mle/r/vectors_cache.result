after_change_user
(empty)
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
# The session's end: the account's next session may get the same worker, empty.
CALL info(@r);
SELECT @r AS next_session;
next_session
(empty)
# 5. Definer and invoker rights: separate caches; a definer routine drops the definer's.
CALL def_search(@r);
SELECT @r AS r;
r
definer: 9 rows
CALL inv_search(@r);
SELECT @r AS r;
r
invoker: 9 rows
CALL def_search(@r);
CALL inv_search(@r);
CALL inv_info(@r);
SELECT @r AS invoker_cache;
invoker_cache
test.shared uses 1
CALL def_drop(@r);
SELECT @r AS r;
r
dropped: true
CALL inv_info(@r);
SELECT @r AS invoker_cache_after;
invoker_cache_after
test.shared uses 1
# 6. Idle expiry: per set (expireAfter), at the start of a request.
CALL java_keep_for('soon', 200, @r);
SELECT @r AS r;
r
soon expires after 200 ms: true
CALL java_keep_for('never', 0, @r);
SELECT @r AS r;
r
never expires after 0 ms: true
SELECT SLEEP(0.5);
SLEEP(0.5)
0
CALL info(@r);
SELECT @r AS cache;
cache
test.never vectors rows 9 uses 0 kept
CALL java_drop_all();
CALL info(@r);
SELECT @r AS after_drop_all;
after_drop_all
(empty)
# 7. A large set dropped: memory given back while the session is idle, in a
#    worker without Python; then the same by idle expiry (mle.vector_cache_idle_ms).
CREATE TABLE big (id BIGINT PRIMARY KEY, v VECTOR(256));
SET GLOBAL mle.sql_result_max = 256 * 1024 * 1024;
CALL fill_big();
CALL java_big('keep', @kept);
CALL java_big('drop', @dropped);
SELECT SLEEP(1);
SLEEP(1)
0
CALL java_big('', @after);
SELECT @kept - @after >= 30 AS heap_given_back_while_idle;
heap_given_back_while_idle
1
SET GLOBAL mle.vector_cache_idle_ms = 500;
CALL java_big('keep', @kept);
SELECT SLEEP(1.5);
SLEEP(1.5)
0
CALL java_big('', @after);
SELECT @kept - @after >= 30 AS expired_while_idle_and_given_back;
expired_while_idle_and_given_back
1
CALL info(@r);
SELECT @r AS cache;
cache
(empty)
SET GLOBAL mle.vector_cache_idle_ms = DEFAULT;
SET GLOBAL mle.sql_result_max = DEFAULT;
# 8. A small limit: least recently used first; a set over it is returned, not kept.
SET GLOBAL mle.vector_cache_max = 400;
CALL java_lru(@r);
SELECT @r AS lru;
lru
kept: s2 true, s3 false, s4 true; the set over the limit returned with 9 rows, kept false
CALL info(@r);
SELECT @r AS cache;
cache
test.s2 vectors rows 2 uses 2 kept
test.s4 vectors rows 4 uses 1 kept
test.all8 vectors rows 9 uses 0 not kept: N MiB is more than mle.vector_cache_max (N MiB)
# 9. 0: off; routines run unchanged and load every call.
SET GLOBAL mle.vector_cache_max = 0;
CALL java_off(@r);
SELECT @r AS off;
off
max 0: loaded twice true, keep false, kept null, refresh null, 0 entries
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
SELECT @r AS still_works;
still_works
9 rows, nearest 1,9
SET GLOBAL mle.vector_cache_max = DEFAULT;
DROP TABLE items, big;
DROP DATABASE other;
DROP USER u1;
DROP PROCEDURE info;
DROP PROCEDURE inv_info;
DROP PROCEDURE js_near;
DROP PROCEDURE py_near;
DROP PROCEDURE js_refresh;
DROP PROCEDURE java_names;
DROP PROCEDURE java_views;
DROP PROCEDURE java_failed_refresh;
DROP PROCEDURE def_search;
DROP PROCEDURE inv_search;
DROP PROCEDURE def_drop;
DROP PROCEDURE java_drop_all;
DROP PROCEDURE java_keep_for;
DROP PROCEDURE fill_big;
DROP PROCEDURE java_big;
DROP PROCEDURE java_lru;
DROP PROCEDURE java_off;
REVOKE CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
