hasData true, next false, count 4
insert: hasData false, affected 2, id 4, columns 0, row null
warnings 1: 2 1292 Truncated incorrect INTEGER value: '12abc'
time: true
TypeError: no column 'nope' in the row
CALL sets(@r);
SELECT @r;
@r
