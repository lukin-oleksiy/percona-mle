# Percona MLE: the launcher and the worker bootstrap in mysqld's plugin
# directory. /usr/lib64 is an alias of /usr/lib for file contexts
# (file_contexts.subs_dist), so this covers /usr/lib64/mysql/plugin/mle too;
# a plain path (no regular expression) takes precedence over /usr/lib's lib_t.
/usr/lib/mysql/plugin/mle/mle_launcher	--	gen_context(system_u:object_r:mle_launcher_exec_t,s0)
/usr/lib/mysql/plugin/mle/mle_worker	--	gen_context(system_u:object_r:mle_worker_exec_t,s0)

# mle.package_dir as the packages and the Docker image suggest; the DBA's
# mle_package writes it, mysqld and the workers read it.
/var/lib/mysql-mle-packages(/.*)?	gen_context(system_u:object_r:mle_packages_t,s0)

# The debug variants (mysqld-debug's plugin directory).
/usr/lib/mysql/plugin/debug/mle/mle_launcher	--	gen_context(system_u:object_r:mle_launcher_exec_t,s0)
/usr/lib/mysql/plugin/debug/mle/mle_worker	--	gen_context(system_u:object_r:mle_worker_exec_t,s0)
