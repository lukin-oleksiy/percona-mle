#
# component_mle: numpy memory in Python routines (exp design note 30).
# GraalPy frees a numpy array only when the Java object referring to it
# is collected, and numpy's malloc does not make the JVM collect: a loop
# of large temporaries outgrew mle.memory_max and the worker was killed.
# The worker's memory watcher causes a young GC (no forced full GC) while
# a call grows (mle_worker_memory_gcs counts them), and workers return
# freed large blocks at once (mle.malloc_mmap_threshold, exp note 45).
# Also: JMX (java.lang.management and the other management packages) is
# out of reach of guest code.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_PYTHON_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
# 1. 3 GiB of numpy temporaries under the default limit (2 GiB): the
# call completes, the watcher caused GCs, no worker was lost.
SELECT @@mle.memory_max / 1024 / 1024 / 1024 AS memory_max_gib,
@@mle.malloc_mmap_threshold AS malloc_mmap_threshold;
memory_max_gib	malloc_mmap_threshold
2.000000000000	4194304
SELECT py_churn(12) AS churn;
churn
12 rounds, total 132
workers lost: 0
SELECT VARIABLE_VALUE > 0 AS watcher_forced_gcs FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'mle_worker_memory_gcs';
watcher_forced_gcs
1
# 2. No JMX from guest code.
SELECT py_jmx() AS python;
python
java.lang.management.ManagementFactory: refused
com.sun.management.HotSpotDiagnosticMXBean: refused
javax.management.MBeanServerFactory: refused
java.util.ArrayList: reachable
SELECT js_jmx() AS javascript;
javascript
TypeError
# 3. mle.malloc_mmap_threshold reaches the workers (GLIBC_TUNABLES);
# 0 leaves glibc's adaptive default; at most 32 MiB.
SELECT worker_tunables();
worker_tunables()
glibc.malloc.mmap_threshold=4194304
SET GLOBAL mle.malloc_mmap_threshold = 33554433;
ERROR 42000: Variable 'mle.malloc_mmap_threshold' can't be set to the value of '33554433'
SET GLOBAL mle.malloc_mmap_threshold = 0;
SELECT worker_tunables();
worker_tunables()
unset
SET GLOBAL mle.malloc_mmap_threshold = DEFAULT;
DROP FUNCTION py_churn;
DROP FUNCTION worker_tunables;
DROP FUNCTION py_jmx;
DROP FUNCTION js_jmx;
REVOKE CREATE_PYTHON_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
