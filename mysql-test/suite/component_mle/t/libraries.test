--echo #
--echo # component_mle (Phase 6): database libraries (CREATE LIBRARY) in
--echo # JavaScript, Oracle's model (MySQL 9.7 manual 27.3.8): USING, static and
--echo # dynamic import, libraries importing libraries; the examples are written
--echo # for this test, the values are Oracle's.
--echo #
--source include/have_mle_component.inc
--source include/count_sessions.inc

INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE ON *.* TO root@localhost;
CREATE DATABASE jslib;
CREATE DATABASE db1;
CREATE DATABASE other;
--connect (con1, localhost, root,,test)

--echo #
--echo # 1. Two libraries, a function using both (USING with aliases):
--echo #    6, 9, -30, 6, 3 (INTEGER rounds 1.5 to 2 and 1.2 to 1).
--echo #
CREATE LIBRARY IF NOT EXISTS jslib.lib1 LANGUAGE JAVASCRIPT AS $$
  export function f(n) {
    return n
  }
$$;
CREATE LIBRARY jslib.lib2 LANGUAGE JAVASCRIPT AS $$ export function g(n) { return n * 2 } $$;
CREATE FUNCTION foo(n INTEGER) RETURNS INTEGER LANGUAGE JAVASCRIPT
  USING (jslib.lib1 AS mylib, jslib.lib2 AS yourlib)
  AS $$ return mylib.f(n) + yourlib.g(n) $$;
SELECT foo(2), foo(3), foo(-10), foo(1.5), foo(1.2);
SELECT LIBRARY_SCHEMA, LIBRARY_NAME, LANGUAGE FROM information_schema.LIBRARIES
  WHERE LIBRARY_SCHEMA = 'jslib' ORDER BY LIBRARY_NAME;
SELECT ROUTINE_NAME, LIBRARY_SCHEMA, LIBRARY_NAME FROM information_schema.ROUTINE_LIBRARIES
  WHERE ROUTINE_SCHEMA = 'test' ORDER BY LIBRARY_NAME;

--echo #
--echo # 2. Dynamic import with a computed path; destructuring the module.
--echo #
CREATE LIBRARY db1.lib_square LANGUAGE JAVASCRIPT AS $$
  export default class Square { constructor() { this.size = 2 } toString() { return 'Square of size ' + this.size } }
$$;
CREATE LIBRARY db1.lib_rectangle LANGUAGE JAVASCRIPT AS $$
  export default class Rectangle { toString() { return 'Rectangle of size 2 by 3' } }
  export function area(w, h) { return w * h }
$$;
CREATE FUNCTION db1.printObject(object_type VARCHAR(20)) RETURNS VARCHAR(40) LANGUAGE JAVASCRIPT AS $$
  const m = await import(`/db1/lib_${object_type}`)
  return String(new m.default())
$$;
CREATE FUNCTION db1.computeRectangle() RETURNS INT LANGUAGE JAVASCRIPT AS $$
  let {default: myRectangle, area: area} = await import("/db1/lib_rectangle")
  return area(2, 3)
$$;
SELECT db1.printObject("square");
SELECT db1.printObject("rectangle");
SELECT db1.computeRectangle();

--echo #
--echo # 3. A library importing a library: 85, 94; the imported one is not
--echo #    visible to the routine (ReferenceError).
--echo #
CREATE LIBRARY db1.mylib LANGUAGE JAVASCRIPT AS $$ export function foo() { return 42 } $$;
CREATE LIBRARY db1.theirlib LANGUAGE JAVASCRIPT AS $$
  import {foo} from "/db1/mylib"
  export function bar() { return 2 * foo() }
$$;
CREATE FUNCTION db1.myfunc(x INT) RETURNS INT LANGUAGE JAVASCRIPT USING (db1.theirlib)
  AS $$ return theirlib.bar() + x $$;
CREATE FUNCTION db1.myfunc2(x INT) RETURNS INT LANGUAGE JAVASCRIPT USING (db1.theirlib)
  AS $$ return mylib.foo() + x $$;
SELECT db1.myfunc(1), db1.myfunc(10);
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT db1.myfunc2(1), db1.myfunc2(10);

--echo #
--echo # 4. Library code runs when imported, not at CREATE; syntax is checked at
--echo #    CREATE.
--echo #
CREATE LIBRARY my_lib LANGUAGE JAVASCRIPT AS $$ throw "MyError" $$;
CREATE FUNCTION my_func(x INTEGER) RETURNS INTEGER LANGUAGE JAVASCRIPT NO SQL
  USING (my_lib) AS $$ return x * 10 $$;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT my_func(8);
--error ER_LANGUAGE_COMPONENT_RUNTIME
CREATE LIBRARY lib3 LANGUAGE JAVASCRIPT AS $$
  export function h() {
    return 1 +* 2
  }
$$;

--echo #
--echo # 5. Ours: a changed library is used at the next call; a dropped one
--echo #    fails the call; libraries of other schemas need USING.
--echo #
SELECT foo(2);
DROP LIBRARY jslib.lib2;
CREATE LIBRARY jslib.lib2 LANGUAGE JAVASCRIPT AS $$ export function g(n) { return n * 100 } $$;
SELECT foo(2);
DROP LIBRARY jslib.lib1;
--error ER_LANGUAGE_COMPONENT_RUNTIME,ER_SP_DOES_NOT_EXIST
SELECT foo(2);
CREATE LIBRARY other.secret LANGUAGE JAVASCRIPT AS $$ export const value = 'from other' $$;
CREATE FUNCTION peek() RETURNS TEXT LANGUAGE JAVASCRIPT AS $$ return (await import('/other/secret')).value $$;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT peek();
CREATE FUNCTION peek_using() RETURNS TEXT LANGUAGE JAVASCRIPT USING (other.secret)
  AS $$ return secret.value + ' / ' + (await import('/other/secret')).value $$;
SELECT peek_using();

--disconnect con1
--connection default
DROP DATABASE jslib;
DROP DATABASE db1;
DROP DATABASE other;
DROP FUNCTION foo;
DROP FUNCTION my_func;
DROP LIBRARY my_lib;
DROP FUNCTION peek;
DROP FUNCTION peek_using;
REVOKE CREATE_JAVASCRIPT_ROUTINE ON *.* FROM root@localhost;
--source include/wait_until_count_sessions.inc
UNINSTALL COMPONENT "file://component_mle";
