#
# component_mle: the vector cache (exp note 76): sets kept between the calls
# of a session by name (Vectors.cached, cachedQuantized, keep, kept, refresh,
# drop, dropAll, expireAfter, cacheInfo); a snapshot; one name, one query;
# names per schema; least recently used evicted at mle.vector_cache_max, a set
# over it not kept, 0 = off; idle expiry (also while the session is idle) and
# memory given back; separate caches per principal; the session's end,
# mle_session_reset() and COM_CHANGE_USER empty it, COM_RESET_CONNECTION does
# not; Java, JavaScript, Python.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVA_ROUTINE, CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE ON *.* TO root@localhost;
SELECT @@mle.vector_cache_max, @@mle.vector_cache_idle_ms;
@@mle.vector_cache_max	@@mle.vector_cache_idle_ms
-1	1800000
SET GLOBAL mle.vector_cache_max = -2;
Got one of the listed errors
SET GLOBAL mle.vector_cache_idle_ms = 604800001;
Got one of the listed errors
CREATE TABLE items (id BIGINT PRIMARY KEY, v VECTOR(4), cat VARCHAR(4));
INSERT INTO items VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 'a'), (2, STRING_TO_VECTOR('[0.9,0.1,0,0]'), 'a'),
(3, STRING_TO_VECTOR('[0,1,0,0]'), 'b'), (4, STRING_TO_VECTOR('[0,0.9,0.1,0]'), 'b'), (5, STRING_TO_VECTOR('[0,0,1,0]'), 'c'),
(6, STRING_TO_VECTOR('[0,0,0.9,0.1]'), 'c'), (7, STRING_TO_VECTOR('[0,0,0,1]'), 'd'), (8, STRING_TO_VECTOR('[0.5,0.5,0,0]'), 'd');
CREATE DATABASE other;
CREATE TABLE other.items (id BIGINT PRIMARY KEY, v VECTOR(4));
INSERT INTO other.items VALUES (100, STRING_TO_VECTOR('[1,1,1,1]')), (101, STRING_TO_VECTOR('[1,0,1,0]'));
CREATE USER u1;
GRANT EXECUTE ON test.* TO u1;
GRANT SELECT ON test.items TO u1;
# 1. Kept between calls; the same set from JavaScript and Python; a snapshot.
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
SELECT @r AS first_call;
first_call
8 rows, nearest 1,2
CALL py_near(STRING_TO_VECTOR('[0,1,0,0]'), @r);
SELECT @r AS python_finds_it;
python_finds_it
8 rows, nearest [3, 4]
INSERT INTO items VALUES (9, STRING_TO_VECTOR('[1,0,0,0.01]'), 'e');
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
SELECT @r AS snapshot;
snapshot
8 rows, nearest 1,2
CALL js_refresh(@r);
SELECT @r AS refreshed;
refreshed
9 rows
CALL js_near(STRING_TO_VECTOR('[1,0,0,0]'), @r);
SELECT @r AS after_refresh;
after_refresh
9 rows, nearest 1,9
CALL info(@r);
SELECT @r AS cache;
cache
test.items vectors rows 9 uses 4 kept
# 2. One name, one query; parameters by value; keep; refresh; failures.
CALL java_names(@r);
SELECT @r AS names;
names
'items' is kept for another query (SELECT id, v, cat FROM items): one name, one query; drop it first
'items' is kept as vectors, not int8: one name, one kind
'byp' is kept for another query (SELECT id, v FROM items WHERE id > ? with [6]): one name, one query; drop it first
'mine' is kept by keep(), without a query: use kept()
'mine' is kept by keep(), without a query to run again
refresh of a name never kept: null
keep replaces: true, now 4 rows
Table 'test.no_such_table' doesn't exist
a cached set needs a name
idleMs must be at least 0 (0: never), not -1
CALL java_views(@r);
SELECT @r AS views;
views
view of 4 rows, int8 set nearest 1; kept bytes count the shared vectors once: true, the base once: true
CREATE TABLE tmp_items (id BIGINT PRIMARY KEY, v VECTOR(4));
INSERT INTO tmp_items VALUES (1, STRING_TO_VECTOR('[1,2,3,4]'));
CALL java_failed_refresh(@r);
SELECT @r AS failed_refresh;
failed_refresh
refresh failed; still kept: 1 rows
