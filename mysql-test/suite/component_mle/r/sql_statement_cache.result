#
# 7. Errors: a failing execution, then the same text again; a wrong number
#    of values; executeMany of a SELECT run before. The routine goes on with
#    right results.
#
CREATE PROCEDURE js_errors(OUT r TEXT) LANGUAGE JAVASCRIPT AS $$
const out = []
for (const v of [100, 100, 101]) {
try { session.runSql('INSERT INTO u VALUES (?)', [v]); out.push('ok ' + v) }
catch (e) { out.push('error ' + e.code) }
}
try { session.runSql('INSERT INTO u VALUES (?)', [1, 2]) } catch (e) { out.push('error ' + e.code) }
// A kept SELECT is new to executeMany: it runs the first row, then refuses.
session.runSql('SELECT ? + 0 AS v', [1])
try { session.executeMany('SELECT ? + 0 AS v', [[1], [2]]) } catch (e) { out.push(e.message + ' row ' + e.row) }
out.push(session.runSql('SELECT GROUP_CONCAT(a ORDER BY a) AS s FROM u WHERE a > ?', [0]).fetchOne().s)
r = out.join(' | ')
$$;
CALL js_errors(@r);
SELECT @r;
@r
ok 100 | error 1062 | ok 101 | error 1210 | executeMany runs statements that return no rows; this one returned a result set (the row was executed) row 0 | 100,101
DELETE FROM u;
#
# 8. More texts than mle.sql_statement_cache: the least recently used goes
#    (three texts in turn, 10 times: 3 preparations with room for 3, 30 with
#    room for 2).
#
CREATE PROCEDURE js_texts(OUT r TEXT) LANGUAGE JAVASCRIPT AS $$
let t = 0
for (let i = 0; i < 10; i++)
for (const q of ['SELECT ? + 1 AS v', 'SELECT ? + 2 AS v', 'SELECT ? + 3 AS v'])
t += session.runSql(q, [i]).fetchOne().v
r = String(t)
$$;
cache	r	prepares
room for 3	195	3
cache	r	prepares
room for 2	195	30
#
# 9. The results a kept statement still holds count in the session's budget
#    and go first when it is short: with mle.sql_call_results_max = 1 every
#    statement still runs (each held result is closed with its statement).
#
SET GLOBAL mle.sql_call_results_max = 1;
CALL js_texts(@r);
SELECT @r;
@r
195
SET GLOBAL mle.sql_call_results_max = DEFAULT;
#
# 10. Kept statements count in the server's max_prepared_stmt_count: at the
#     bound they are closed, and the statement is prepared once more. None
#     outlives its CALL.
#
SET @old_max_prepared = @@GLOBAL.max_prepared_stmt_count;
SHOW GLOBAL STATUS LIKE "Prepared_stmt_count";
Variable_name	Value
Prepared_stmt_count	0
SET GLOBAL max_prepared_stmt_count = 2;
CALL js_texts(@r);
SELECT @r;
@r
195
SET GLOBAL max_prepared_stmt_count = @old_max_prepared;
# None outlives its CALL.
SHOW GLOBAL STATUS LIKE "Prepared_stmt_count";
Variable_name	Value
Prepared_stmt_count	0
DROP PROCEDURE prepares;
DROP PROCEDURE js_loop;
DROP PROCEDURE java_loop;
DROP PROCEDURE cpy_loop;
DROP PROCEDURE v8_loop;
DROP PROCEDURE js_prepared;
DROP PROCEDURE js_tables;
DROP PROCEDURE concat_mode;
DROP PROCEDURE pipes_mode;
DROP PROCEDURE js_modes;
DROP PROCEDURE js_use;
DROP PROCEDURE js_kinds;
DROP PROCEDURE cpy_kinds;
DROP PROCEDURE js_errors;
DROP PROCEDURE js_texts;
DROP TABLE t, u, w;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_JAVA_ROUTINE, CREATE_CPYTHON_ROUTINE, CREATE_JS_ROUTINE
ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
