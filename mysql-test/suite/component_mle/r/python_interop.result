#
# component_mle: Python code and the other languages (exp note 41).
# 1. except Exception catches errors of JavaScript and Java (GraalPy gives
#    them as polyglot.ForeignException, a BaseException only): Java's by a
#    registered interop type, JavaScript's by MLE's compilation of routine,
#    library and mle_eval code.
# 2. Rows take row['label'] besides row.label and row[0]; iteration and
#    len() stay a tuple's.
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
CREATE LIBRARY jsv LANGUAGE JAVASCRIPT AS $$
export function boom() { throw new RangeError('out of range') }
$$;
# 1.
SELECT py_exc();
py_exc()
js: RangeError: RangeError: out of range | java: java.lang.NumberFormatException: For input string: "x" | in a tuple | in a class | not by ValueError
SELECT py_lib_catch();
py_lib_catch()
library caught: RangeError: RangeError: out of range
SELECT mle_eval('python', 'import java\ntry:\n  java.type("java.lang.Integer").parseInt("y")\nexcept Exception as e:\n  print("mle_eval caught it")');
mle_eval('python', 'import java\ntry:\n  java.type("java.lang.Integer").parseInt("y")\nexcept Exception as e:\n  print("mle_eval caught it")')
mle_eval caught it

# 2.
CALL py_rows(@r);
SELECT @r;
@r
x | 1 | 1 | x | x | 3 | [1, 'x', None] | None | KeyError
# JavaScript rows are unchanged.
CREATE PROCEDURE js_rows(OUT r TEXT) LANGUAGE JAVASCRIPT AS $$
const row = session.runSql("SELECT 1 AS a, 'x' AS name").fetchOne()
r = [row.name, row['name'], row[0], row.length, [...row].join(',')].join(' | ')
$$;
CALL js_rows(@r);
SELECT @r;
@r
x | x | 1 | 2 | 1,x
DROP FUNCTION py_exc;
DROP FUNCTION py_lib_catch;
DROP PROCEDURE py_rows;
DROP PROCEDURE js_rows;
DROP LIBRARY jsv;
DROP LIBRARY pycatch;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
