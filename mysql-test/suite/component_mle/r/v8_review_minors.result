# C94, C106, C107: mle_set_session_state() takes a JSON object of its options; NULL arguments.
SELECT mle_set_session_state('');
ERROR HY000: mle_set_session_state<int> UDF failed; the argument must be a JSON object of options, such as {"integer_type": "BIGINT"}
SELECT mle_set_session_state('not json');
ERROR HY000: mle_set_session_state<int> UDF failed; the argument must be a JSON object of options, such as {"integer_type": "BIGINT"}
SELECT mle_set_session_state('[]');
ERROR HY000: mle_set_session_state<int> UDF failed; the argument must be a JSON object of options, such as {"integer_type": "BIGINT"}
SELECT mle_set_session_state('null');
ERROR HY000: mle_set_session_state<int> UDF failed; the argument must be a JSON object of options, such as {"integer_type": "BIGINT"}
SELECT mle_set_session_state('{"integer_type": 1}');
ERROR HY000: mle_set_session_state<int> UDF failed; the value of integer_type must be a string
SELECT mle_set_session_state('{"integer_type": "BIGINT"} trailing');
ERROR HY000: mle_set_session_state<int> UDF failed; the argument must be a JSON object of options, such as {"integer_type": "BIGINT"}
SELECT mle_set_session_state(NULL);
