--echo #
--echo # component_mle: debugging routines (exp note 39). A runtime error names
--echo # where it happened; mle_session_state('traceback') shows the frames in
--echo # the language's own form with their source lines; 'last_output' is what
--echo # the last call printed; mle.console = WARNINGS adds a call's output and a
--echo # failure's traceback to the statement's warnings.
--echo #
--source ../include/have_mle_component.inc
--source include/count_sessions.inc

INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;

--write_file $MYSQLTEST_VARDIR/tmp/debugging.sql
CREATE FUNCTION py_div(a INT) RETURNS INT LANGUAGE PYTHON AS $$
    def helper(v):
        return 10 // v
    print('before, a =', a)
    return helper(a - a)
$$;
CREATE FUNCTION js_div(a INT) RETURNS INT LANGUAGE JAVASCRIPT AS $$
  function helper(v) { return v.missing.field }
  console.log('before, a =', a)
  return helper({})
$$;
CREATE FUNCTION java_div(a INT) RETURNS INT LANGUAGE JAVA AS $$
  int[] arr = new int[2];
  System.out.println("before, a = " + a);
  return arr[a + 5];
$$;
CREATE FUNCTION py_talk(n INT) RETURNS INT LANGUAGE PYTHON AS $$
    import sys
    for i in range(n):
        print('step', i, 'square', i * i)
    print('done', file=sys.stderr)
    return n
$$;
EOF
--exec $MYSQL test < $MYSQLTEST_VARDIR/tmp/debugging.sql 2>&1
--remove_file $MYSQLTEST_VARDIR/tmp/debugging.sql

--connect (con1, localhost, root,,test)
--echo # 1. The error message names the routine, the line and the function.
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT py_div(1);
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT js_div(1);
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT java_div(1);

--echo # 2. The traceback in each language's form, with source lines.
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT py_div(1);
SELECT mle_session_state('traceback') AS traceback;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT js_div(1);
SELECT mle_session_state('traceback') AS traceback;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT java_div(1);
SELECT mle_session_state('traceback') AS traceback;
--echo # Oracle's stack_trace stays as it was.
SELECT mle_session_state('stack_trace') AS stack_trace;

--echo # 3. last_output: only what the last call printed (stdout: the session's).
SELECT py_talk(2);
SELECT mle_session_state('last_output') AS last_output;
SELECT LENGTH(mle_session_state('stdout')) > LENGTH(mle_session_state('last_output')) AS stdout_has_more;

--echo # 4. mle.console = WARNINGS: the output and the traceback as warnings.
SELECT @@session.mle.console;
SET SESSION mle.console = WARNINGS;
SELECT py_talk(3);
SHOW WARNINGS;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT py_div(1);
SHOW WARNINGS;
--echo # Only what the call printed: py_talk(0) writes only to stderr.
SELECT py_talk(0);
SHOW WARNINGS;
SET SESSION mle.console = DEFAULT;
--error ER_WRONG_VALUE_FOR_VAR
SET SESSION mle.console = 'loud';

--echo # 5. mle_eval(language, code): a snippet without CREATE; what it printed,
--echo #    then the value of its last expression.
SELECT mle_eval('python', 'import numpy as np\nnp.arange(5) * 2') AS python;
SELECT mle_eval('python', 'print("hello")\n6 * 7') AS printed_and_value;
SELECT mle_eval('javascript', 'const a = [1, 2, 3]; a.map(x => x * 2)') AS javascript;
--echo # let/const stay in the snippet: the same snippet again.
SELECT mle_eval('javascript', 'const a = [1, 2, 3]; a.map(x => x * 2)') AS again;
SELECT mle_eval('java', 'Math.max(3, 7)') AS java_expression;
SELECT mle_eval('java', 'int s = 0;\nfor (int i = 0; i < 4; i++) s += i;\nSystem.out.println("sum " + s);') AS java_statements;
SELECT mle_eval('python', 'x = 1') IS NULL AS no_value;
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT mle_eval('python', 'a = 1\nb = 0\na / b');
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT mle_eval('javascript', 'let = ;');
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT mle_eval('python', 'x = (1,');
--error ER_LANGUAGE_COMPONENT_RUNTIME
SELECT mle_eval('python', 'session.run_sql("SELECT 1")');
--error ER_UDF_ERROR
SELECT mle_eval('cobol', '1');

--echo # 6. CREATE checks Python code beyond its syntax: names that are read but
--echo #    never defined (a typo) are warnings; the routine is created.
CREATE FUNCTION py_typo(word VARCHAR(20)) RETURNS INT LANGUAGE PYTHON AS $$
n = len(word)
return lenght if n > 3 else n
$$;
SHOW WARNINGS;
--echo # Parameters, MLE's globals, imports, functions, comprehensions,
--echo # lambdas: no warnings.
CREATE PROCEDURE py_clean(IN k INT) LANGUAGE PYTHON AS $$
import math
from collections import Counter
def sq(v): return v * v
cube = lambda x: x ** 3
total = sum(sq(i) + cube(j) for i in range(k) for j in [i])
c = Counter([1, 1, 2])
print(math.sqrt(total), c[1], isinstance(session, object), mysql, [w for w in ['a'] if w])
$$;
SHOW WARNINGS;
--echo # exec(): no check (the names it defines are unknown).
CREATE FUNCTION py_star() RETURNS INT LANGUAGE PYTHON AS $$
ns = {}
exec('x = 4', ns)
return ns['x'] + unknown_but_unchecked if False else ns['x']
$$;
SHOW WARNINGS;
--echo # Errors that Python finds after parsing are compile errors too (the
--echo # body is a function body).
--error ER_LANGUAGE_COMPONENT_RUNTIME
CREATE FUNCTION py_star_import() RETURNS DOUBLE LANGUAGE PYTHON AS $$
from math import *
return sqrt(4)
$$;
--echo # The routine runs; later loads do not repeat the warning, and the
--echo # findings are not in the session's stderr.
SELECT py_typo('ab');
SHOW WARNINGS;
SELECT LOCATE('mle-check', mle_session_state('stderr')) AS marker_in_stderr;
DROP FUNCTION py_typo;
DROP PROCEDURE py_clean;
DROP FUNCTION py_star;

--disconnect con1
--connection default
--echo # The language's CREATE privilege is needed.
CREATE USER u_eval@localhost;
GRANT CREATE_JAVASCRIPT_ROUTINE ON *.* TO u_eval@localhost;
--connect (con2, localhost, u_eval,,)
SELECT mle_eval('javascript', '1 + 1') AS allowed;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
SELECT mle_eval('python', '1 + 1');
--disconnect con2
--connection default
DROP USER u_eval@localhost;
DROP FUNCTION py_div;
DROP FUNCTION js_div;
DROP FUNCTION java_div;
DROP FUNCTION py_talk;
REVOKE CREATE_JAVASCRIPT_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
--source include/wait_until_count_sessions.inc
UNINSTALL COMPONENT "file://component_mle";
