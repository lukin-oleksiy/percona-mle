[mysqld]
user = mysql
basedir = /usr/local/mysql
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid
plugin-dir = /usr/local/mysql/lib/plugin
bind-address = 0.0.0.0
# No log-error: mysqld logs to stderr (docker logs).
# Percona telemetry is not part of this POC image.
percona_telemetry_disable = ON
# Binary logging is on: let application accounts (no SUPER) create stored
# functions, as in a development setup.
log_bin_trust_function_creators = ON
# component_mle (read-only settings; component variables come from here at
# startup): the package volume (19 §2). The JDK is <mle.dir>/jdk (default).
loose-mle.package_dir = /var/lib/mysql-mle-packages

[client]
socket = /var/run/mysqld/mysqld.sock
