#
# component_mle: text in utf8mb4, the one character set of this
# proof of concept. Routines are created and called by utf8mb4 clients;
# other client character sets are not supported (the independent
# review's C8: a routine created by a latin1 client stores the
# non-ASCII text of its SQL wrongly).
#
INSTALL COMPONENT "file://component_mle";
GRANT CREATE_JS_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* TO root@localhost;
SET NAMES utf8mb4;
SELECT @@character_set_client, @@character_set_connection, @@character_set_results;
@@character_set_client	@@character_set_connection	@@character_set_results
utf8mb4	utf8mb4	utf8mb4
SET @s = 'héllo Київ 日本 😀';
SELECT HEX(@s) AS expected;
expected
68C3A96C6C6F20D09AD0B8D197D0B220E697A5E69CAC20F09F9880
CREATE TABLE cs (id INT PRIMARY KEY, who VARCHAR(10), v VARCHAR(40)) CHARACTER SET utf8mb4;
CREATE TABLE l1 (v VARCHAR(40)) CHARACTER SET latin1;
INSERT INTO l1 VALUES ('héllo');
# Arguments and return values.
CREATE FUNCTION js_echo(s VARCHAR(40)) RETURNS VARCHAR(40) LANGUAGE JS AS $$ return s $$;
CREATE FUNCTION py_echo(s VARCHAR(40)) RETURNS VARCHAR(40) LANGUAGE PYTHON AS $$ return s $$;
CREATE FUNCTION java_echo(s VARCHAR(40)) RETURNS VARCHAR(40) LANGUAGE JAVA AS $$ return s; $$;
SELECT js_echo(@s) = @s AS js, py_echo(@s) = @s AS py, java_echo(@s) = @s AS java,
HEX(js_echo(@s)) = HEX(@s) AS js_bytes, HEX(py_echo(@s)) = HEX(@s) AS py_bytes,
HEX(java_echo(@s)) = HEX(@s) AS java_bytes;
js	py	java	js_bytes	py_bytes	java_bytes
1	1	1	1	1	1
# A literal of the routine's own text; characters are counted as
# characters (Python), not bytes.
CREATE FUNCTION js_lit() RETURNS VARCHAR(40) LANGUAGE JS AS $$ return 'héllo Київ 日本 😀' $$;
Warnings:
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
CREATE FUNCTION py_lit() RETURNS VARCHAR(40) LANGUAGE PYTHON AS $$ return 'héllo Київ 日本 😀' $$;
Warnings:
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
CREATE FUNCTION java_lit() RETURNS VARCHAR(40) LANGUAGE JAVA AS $$ return "héllo Київ 日本 😀"; $$;
Warnings:
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
CREATE FUNCTION py_len(s VARCHAR(40)) RETURNS INT LANGUAGE PYTHON AS $$ return len(s) $$;
SELECT js_lit() = @s AS js, py_lit() = @s AS py, java_lit() = @s AS java,
py_len(@s) AS py_len, CHAR_LENGTH(@s) AS sql_len;
js	py	java	py_len	sql_len
1	1	1	15	15
Warnings:
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string ' retur...' from utf8mb4 to utf8mb3
# The same from plain SQL, to compare (the warning is the server's).
CREATE FUNCTION sql_lit() RETURNS VARCHAR(40) RETURN 'héllo Київ 日本 😀';
Warnings:
Warning	1300	Cannot convert string 'h\xC3\xA9llo...' from utf8mb4 to utf8mb3
SELECT sql_lit() = @s AS sqlf;
sqlf
1
Warnings:
Warning	1300	Cannot convert string 'h\xC3\xA9llo...' from utf8mb4 to utf8mb3
SELECT ROUTINE_NAME, ROUTINE_DEFINITION FROM information_schema.ROUTINES
WHERE ROUTINE_SCHEMA = 'test' AND ROUTINE_NAME IN ('js_lit', 'sql_lit') ORDER BY 1;
ROUTINE_NAME	ROUTINE_DEFINITION
js_lit	 return 'héllo Київ 日本 ?' 
sql_lit	RETURN 'héllo Київ 日本 ?'
SHOW CREATE FUNCTION js_lit;
Function	sql_mode	Create Function	character_set_client	collation_connection	Database Collation
js_lit	ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION	CREATE DEFINER=`root`@`localhost` FUNCTION `js_lit`() RETURNS varchar(40) CHARSET utf8mb4
    LANGUAGE JS
AS $$ return 'héllo Київ 日本 😀' $$	utf8mb4	utf8mb4_0900_ai_ci	utf8mb4_0900_ai_ci
DROP FUNCTION sql_lit;
# An argument from a latin1 column arrives converted (C3A9 for é).
SELECT HEX(js_echo(v)) AS js, HEX(py_echo(v)) AS py, HEX(java_echo(v)) AS java FROM l1;
js	py	java
68C3A96C6C6F	68C3A96C6C6F	68C3A96C6C6F
# SQL from the routine: a literal in the statement, a parameter, the
# value read back, and a write to a latin1 column.
CALL js_sql(@s, @r);
Warnings:
Warning	1300	Cannot convert string '\x0A  ses...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string '\x0A  ses...' from utf8mb4 to utf8mb3
SELECT @r;
@r
true/1 true/1 true/1 C3A9 C3A9 15
CALL py_sql(@s, @r);
Warnings:
Warning	1300	Cannot convert string '\x0A    s...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string '\x0A    s...' from utf8mb4 to utf8mb3
SELECT @r;
@r
true/1 true/1 true/1 C3A9 C3A9 15
CALL java_sql(@s, @r);
Warnings:
Warning	1300	Cannot convert string '\x0A  var...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string '\x0A  var...' from utf8mb4 to utf8mb3
SELECT @r;
@r
true/1 true/1 true/1 C3A9 C3A9 15
SELECT COUNT(*) AS n, COUNT(DISTINCT HEX(v)) AS different, MIN(HEX(v)) = HEX(@s) AS as_expected FROM cs;
n	different	as_expected
9	1	1
SELECT HEX(v) AS latin1_bytes, COUNT(*) AS n FROM l1 GROUP BY HEX(v) ORDER BY 1;
latin1_bytes	n
636166E9	3
68E96C6C6F	1
# Identifiers and column names.
CREATE TABLE `таблиця` (`назва` VARCHAR(20), `日本` INT);
INSERT INTO `таблиця` VALUES ('Дніпро', 1);
CREATE PROCEDURE js_names(OUT r TEXT) LANGUAGE JS AS $$
const res = session.runSql("SELECT `назва`, `日本` FROM `таблиця`")
const row = res.fetchOne()
r = res.getColumnNames().join(',') + ' ' + row['назва'] + ' ' + row['日本']
$$;
CALL js_names(@r);
SELECT @r = 'назва,日本 Дніпро 1' AS names;
names
1
# Errors and printed text.
CREATE FUNCTION js_fail() RETURNS INT LANGUAGE JS AS $$ throw new Error('помилка 😀') $$;
Warnings:
Warning	1300	Cannot convert string ' throw...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string ' throw...' from utf8mb4 to utf8mb3
SELECT js_fail();
ERROR HY000: JavaScript> Error: помилка ð (js_fail, line 1)
# The server's messages are utf8mb3: a plain SIGNAL, to compare.
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'помилка 😀';
ERROR 45000: помилка ?
SELECT mle_session_state('traceback') LIKE '%помилка 😀%' AS traceback_keeps_it;
traceback_keeps_it
1
CREATE FUNCTION py_print() RETURNS INT LANGUAGE PYTHON AS $$
print('друк 日本 😀')
return 1
$$;
Warnings:
Warning	1300	Cannot convert string '\x0Aprint...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string '\x0Aprint...' from utf8mb4 to utf8mb3
SELECT py_print();
py_print()
1
Warnings:
Warning	1300	Cannot convert string '\x0Aprint...' from utf8mb4 to utf8mb3
Warning	1300	Cannot convert string '\x0Aprint...' from utf8mb4 to utf8mb3
SELECT mle_session_state('last_output') = 'друк 日本 😀\n' AS printed;
printed
1
DROP TABLE cs, l1, `таблиця`;
DROP FUNCTION js_echo;
DROP FUNCTION py_echo;
DROP FUNCTION java_echo;
DROP FUNCTION js_lit;
DROP FUNCTION py_lit;
DROP FUNCTION java_lit;
DROP FUNCTION py_len;
DROP PROCEDURE js_sql;
DROP PROCEDURE py_sql;
DROP PROCEDURE java_sql;
DROP PROCEDURE js_names;
DROP FUNCTION js_fail;
DROP FUNCTION py_print;
REVOKE CREATE_JS_ROUTINE, CREATE_PYTHON_ROUTINE, CREATE_JAVA_ROUTINE ON *.* FROM root@localhost;
UNINSTALL COMPONENT "file://component_mle";
