SELECT mle_set_session_state('{"integer_type": "BIGINT"}') AS first, mle_set_session_state('{"decimal_type": "NUMBER"}') AS second,
mle_set_session_state('{}') AS nothing;
first	second	nothing
1	1	1
CREATE FUNCTION js_kinds(i BIGINT, d DECIMAL(10,2)) RETURNS TEXT LANGUAGE JS AS $$ return typeof i + ' ' + typeof d $$;
SELECT js_kinds(1, 1.5) AS both_kept;
both_kept
bigint number
# NULL is refused for every argument (by the UDF framework).
SELECT mle_eval('js', NULL);
ERROR HY000: mle_eval<string> UDF failed; argument 2 cannot be null
SELECT mle_eval(NULL, '1');
ERROR HY000: mle_eval<string> UDF failed; argument 1 cannot be null
SELECT mle_session_state(NULL);
ERROR HY000: mle_session_state<string> UDF failed; argument 1 cannot be null
SELECT mle_session_reset(NULL);
ERROR HY000: mle_session_reset<string> UDF failed; argument 1 cannot be null
SET NAMES latin1;
SELECT mle_eval('js', CONCAT('"', _latin1 0xE9, '".charCodeAt(0)')) AS e_acute_is_233;
e_acute_is_233
233
SET NAMES utf8mb4;
# C39: the names libraries get in a routine are identifiers.
CREATE LIBRARY lib1 LANGUAGE JS AS $$ export function f() { return 1 } $$;
CREATE FUNCTION bad1() RETURNS INT LANGUAGE JS USING (lib1 AS `x=1;evil()`) AS $$ return 1 $$;
ERROR HY000: JavaScript> The identifier 'x=1;evil()' is not valid.
CREATE FUNCTION bad2() RETURNS INT LANGUAGE JS USING (lib1 AS `$c`) AS $$ return 1 $$;
ERROR HY000: JavaScript> The identifier '$c' is not valid.
CREATE FUNCTION bad3(a INT) RETURNS INT LANGUAGE JS USING (lib1 AS a) AS $$ return 1 $$;
ERROR HY000: JavaScript> The identifier 'a' is not valid.
CREATE FUNCTION bad4() RETURNS INT LANGUAGE JS USING (lib1 AS l, lib1 AS l) AS $$ return 1 $$;
ERROR HY000: JavaScript> The identifier 'l' is not valid.
CREATE FUNCTION bad5() RETURNS INT LANGUAGE JS USING (lib1 AS class) AS $$ return 1 $$;
ERROR HY000: JavaScript> The identifier 'class' is not valid.
CREATE FUNCTION good() RETURNS INT LANGUAGE JS USING (lib1 AS l) AS $$ return l.f() $$;
SELECT good();
good()
1
# C47: a JavaScript library with a '.' in its name is not taken for another one.
CREATE LIBRARY `lib1.ab` LANGUAGE JS AS $$ export function f() { return 2 } $$;
CREATE FUNCTION dotted() RETURNS INT LANGUAGE JS USING (`lib1.ab` AS l) AS $$ return l.f() $$;
SELECT dotted();
Got one of the listed errors
DROP FUNCTION dotted;
DROP LIBRARY `lib1.ab`;
# C128: the text of a frame on a JavaScript body's first line is the body's.
CREATE FUNCTION js_line1() RETURNS INT LANGUAGE JS AS $$ const answer = 42; null.oops $$;
SELECT js_line1();
ERROR HY000: JavaScript> TypeError: Cannot read properties of null (reading 'oops') (js_line1, line 1)
SELECT mle_session_state('traceback') AS traceback;
traceback
TypeError: Cannot read properties of null (reading 'oops')
    at js_line1:1:21
        const answer = 42; null.oops

DROP FUNCTION js_line1;
# C86: SET ... = DEFAULT of a setting that shapes workers, while a session holds one.
SET GLOBAL mle.heap_max = 268435456;
SELECT js_one();
js_one()
1
# Not checked by the server before the update: refused there, with a warning.
SET GLOBAL mle.heap_max = DEFAULT;
Warnings:
Warning	6000	MLE: mle.heap_max is not changed: a session holds a worker
SET GLOBAL mle.heap_max = 300000000;
ERROR HY000: Language component: System variable 'mle.heap_max' cannot be configured when component is active.
SELECT @@GLOBAL.mle.heap_max AS unchanged;
unchanged
268435456
SET GLOBAL mle.heap_max = DEFAULT;
SELECT @@GLOBAL.mle.heap_max = 536870912 AS the_default;
the_default
1
# C124: fetchColumns() with names, a NULL and a column that is not there.
CREATE PROCEDURE js_columns(OUT r TEXT) LANGUAGE JS AS $$
const q = "SELECT 1 AS a, NULL AS b, 'x' AS c UNION ALL SELECT 2, 5, 'y'"
  const out = []
const one = session.runSql(q).fetchColumns('c', 'a')
out.push(Object.keys(one).join('') + ' ' + one.c + ' ' + one.a)
out.push('b ' + session.runSql(q).fetchColumns(['b']).b)
try { session.runSql(q).fetchColumns('nope'); out.push('found') } catch (e) { out.push(e.message) }
r = out.join(', ')
$$;
CALL js_columns(@r);
SELECT @r;
@r
ca x,y 1,2, b ,5, no column 'nope' in the result
DROP PROCEDURE js_columns;
# C134: mle.max_workers. This session holds a worker: another gets none, new or kept.
SET GLOBAL mle.max_workers = 1;
SELECT js_one();
ERROR HY000: Language component: Concurrency limit (mle.max_workers = 1) has been reached.
SELECT js_one() AS the_holder_goes_on;
the_holder_goes_on
1
SET GLOBAL mle.max_workers = DEFAULT;
SELECT js_one() AS room_again;
room_again
1
# C135: KILL of a connection inside a routine; an account renamed while a worker is kept for it.
CREATE FUNCTION js_spin() RETURNS INT LANGUAGE JS AS $$ while (true) {} $$;
SELECT js_spin();
Got one of the listed errors
SELECT js_one() AS others_go_on;
others_go_on
1
DROP FUNCTION js_spin;
